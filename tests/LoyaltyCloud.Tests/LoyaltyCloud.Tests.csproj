<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LoyaltyCloud.Tests</RootNamespace>
    <AssemblyName>LoyaltyCloud.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoyaltyCloud.Common\LoyaltyCloud.Common.csproj" />
    <ProjectReference Include="..\..\src\LoyaltyCloud.Domain\LoyaltyCloud.Domain.csproj" />
    <ProjectReference Include="..\..\src\LoyaltyCloud.Application\LoyaltyCloud.Application.csproj" />
    <ProjectReference Include="..\..\src\LoyaltyCloud.Infrastructure\LoyaltyCloud.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LoyaltyCloud.API\LoyaltyCloud.API.csproj" />
    <ProjectReference Include="..\..\src\LoyaltyCloud.Admin\LoyaltyCloud.Admin.csproj" Aliases="AdminApp" />
    <ProjectReference Include="..\..\src\LoyaltyCloud.Tools\LoyaltyCloud.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Integration testing -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <!-- Compile the platform-independent mobile logic for executable host tests. -->
  <ItemGroup>
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/CashierContracts.cs" Link="Cashier/CashierContracts.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/AuthenticatedCashierApiClient.cs" Link="Cashier/AuthenticatedCashierApiClient.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/CashierRedemptionService.cs" Link="Cashier/CashierRedemptionService.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/RewardRedemptionCoordinator.cs" Link="Cashier/RewardRedemptionCoordinator.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/CashierGiftCardContracts.cs" Link="Cashier/CashierGiftCardContracts.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/CashierGiftCardApi.cs" Link="Cashier/CashierGiftCardApi.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/GiftCardQrParser.cs" Link="Cashier/GiftCardQrParser.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/GiftCardRedemptionCoordinator.cs" Link="Cashier/GiftCardRedemptionCoordinator.cs" />
    <Compile Include="../../src/LoyaltyCloud.Cashier/Services/CashierQrPayloadParser.cs" Link="Cashier/CashierQrPayloadParser.cs" />
  </ItemGroup>
</Project>

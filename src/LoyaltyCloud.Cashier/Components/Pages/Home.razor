    private async Task ConfirmPendingRedemptionAsync()
    {
        if (busy || customer is null || pendingRedemption is null)
            return;

        busy = true;
        errorMessage = null;
        successMessage = null;
        var serial = customer.SerialNumber;
        var rewardName = pendingRedemption.RewardName;
        try
        {
            var result = await Redemptions.ConfirmAsync(pendingRedemption.RedemptionId);
            if (!result.Succeeded)
            {
                errorMessage = result.ErrorMessage ?? "No fue posible confirmar el canje.";
                if (result.Unauthorized)
                    session = null;
                return;
            }

            await ClearPendingRedemptionAsync();
            successMessage = $"Canje confirmado: {rewardName}.";
            await RefreshCustomerAndCatalogAsync(serial);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CancelPendingRedemptionAsync()
    {
        if (busy || customer is null || pendingRedemption is null)
            return;

        busy = true;
        errorMessage = null;
        successMessage = null;
        var serial = customer.SerialNumber;
        try
        {
            var result = await Redemptions.CancelAsync(pendingRedemption.RedemptionId);
            if (!result.Succeeded || result.Value is null)
            {
                errorMessage = result.ErrorMessage ?? "No fue posible cancelar el canje.";
                if (result.Unauthorized)
                    session = null;
                return;
            }

            await ClearPendingRedemptionAsync();
            successMessage = $"Canje cancelado. Se restauraron {result.Value.PointsRestored:N0} puntos.";
            await RefreshCustomerAndCatalogAsync(serial);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RefreshCustomerAndCatalogAsync(string serial)
    {
        var refresh = await Customers.GetCustomerAsync(serial);
        if (refresh.Succeeded && refresh.Value is not null)
            customer = refresh.Value;
        else if (refresh.Unauthorized)
            session = null;

        await LoadCatalogAsync(serial);
    }

    private Task ReloadCatalogIfVisibleAsync(string serial) =>
        pointsOperation == PointsOperation.RedeemReward && catalog is not null
            ? LoadCatalogAsync(serial)
            : Task.CompletedTask;

    private void ClearCustomer()
    {
        customer = null;
        lookup.SerialNumber = string.Empty;
        points.PurchaseAmount = null;
        errorMessage = null;
        successMessage = null;
        ClearRedemptionState();
    }

    private void ClearRedemptionState()
    {
        catalog = null;
        selectedReward = null;
        pendingRewardOperation = null;
        pendingMonetaryOperation = null;
        pendingRedemption = null;
        monetaryPreview = null;
        monetaryPointsInput = string.Empty;
        redemptionMode = RedemptionMode.CatalogRewards;
        pointsOperation = PointsOperation.AddPoints;
        catalogLoading = false;
    }

    private void ClearRedemptionSelection()
    {
        selectedReward = null;
        monetaryPreview = null;
        monetaryPointsInput = string.Empty;
    }

    private async Task RestorePendingRewardRedemptionAsync()
    {
        try
        {
            pendingMonetaryOperation = await MonetaryRedemptions.LoadAsync();
        }
        catch (InvalidOperationException)
        {
            errorMessage = "Hay un descuento pendiente que no se pudo verificar. Inicia sesión con la misma cuenta y contacta al administrador.";
            return;
        }

        try
        {
            pendingRewardOperation = await RewardRedemptions.LoadAsync();
        }
        catch (InvalidOperationException)
        {
            errorMessage = "Hay un canje pendiente que no se pudo verificar. Inicia sesión con la misma cuenta y contacta al administrador.";
            return;
        }

        if (pendingMonetaryOperation is null && pendingRewardOperation is null)
            return;

        giftMode = false;
        pointsOperation = PointsOperation.RedeemReward;
        selectedReward = null;
        monetaryPreview = null;
        redemptionMode = pendingMonetaryOperation is not null ? RedemptionMode.MonetaryDiscount : RedemptionMode.CatalogRewards;
        pendingRedemption = pendingMonetaryOperation?.CreatedRedemption ?? pendingRewardOperation?.CreatedRedemption;
        var serial = pendingMonetaryOperation?.SerialNumber ?? pendingRewardOperation!.SerialNumber;
        lookup.SerialNumber = serial;

        var result = await Customers.GetCustomerAsync(serial);
        if (result.Succeeded && result.Value is not null)
            customer = result.Value;
        else if (result.Unauthorized)
            session = null;

        successMessage = pendingRedemption is null
            ? "Hay un canje pendiente por resolver. Reintenta antes de iniciar otro."
            : "Hay un canje pendiente. Confirma la entrega o cancela para restaurar puntos.";
    }

    private async Task ClearPendingRedemptionAsync()
    {
        var wasMonetary = pendingMonetaryOperation is not null
            || pendingRedemption?.MonetaryAmount is not null;
        pendingRedemption = null;
        pendingRewardOperation = null;
        pendingMonetaryOperation = null;
        if (wasMonetary)
            await MonetaryRedemptions.ClearAsync();
        else
            await RewardRedemptions.ClearAsync();
    }

    private static bool TryParsePositivePoints(string value, out int pointsToRedeem) =>
        int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out pointsToRedeem)
        && pointsToRedeem > 0;

    private static string FormatMoney(decimal amount, string? currency) =>
        string.Equals(currency, "MXN", StringComparison.OrdinalIgnoreCase)
            ? $"${amount:N2}"
            : $"{amount:N2} {currency}";

    private void OnSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            session = Sessions.Current;
            if (session is null)
            {
                giftMode = giftBusy = giftPending = false;
                RestoreLoginIdentifiers();
            }
            StateHasChanged();
        });
    }

    private void RestoreLoginIdentifiers()
    {
        (rememberMe, login.TenantSlug, login.Username) = LoginPreferences.Load();
        login.Password = string.Empty;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Ingresa el negocio.")]

        [Required(ErrorMessage = "Ingresa el usuario.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la contraseña.")]
        public string Password { get; set; } = string.Empty;
    }

    private sealed class CustomerLookupModel
    {
        [Required(ErrorMessage = "Ingresa el ID del cliente.")]
        public string SerialNumber { get; set; } = string.Empty;
    }

    private sealed class AddPointsModel
    {
        [Range(typeof(decimal), "0.01", "999999999", ErrorMessage = "Ingresa un monto mayor a cero.")]
        public decimal? PurchaseAmount { get; set; }
    }

    private enum PointsOperation
    {
        AddPoints,
        RedeemReward
    }

    private enum RedemptionMode
    {
        CatalogRewards,
        MonetaryDiscount
    }

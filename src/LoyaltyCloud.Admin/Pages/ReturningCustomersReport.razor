@page "/reports/returning-customers"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISender Sender
<PageTitle>Clientes recurrentes - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Reportes avanzados</span><h1>Clientes recurrentes</h1><p>Mide fidelización real comparando clientes nuevos con quienes regresan.</p></div></header><ReportSubnav />
<section class="kb-card kb-reports-filters"><div><label for="retentionPeriod">Periodo</label><select id="retentionPeriod" @bind="period" @bind:after="LoadAsync"><option value="month">Mes actual</option><option value="30">Últimos 30 días</option><option value="90">Últimos 90 días</option><option value="6m">Últimos 6 meses</option><option value="custom">Personalizado</option></select></div>@if(period=="custom"){<div><label for="retentionStart">Fecha inicio</label><input id="retentionStart" type="date" @bind="customStart" /></div><div><label for="retentionEnd">Fecha fin</label><input id="retentionEnd" type="date" @bind="customEnd" /></div><button class="kb-btn kb-btn--primary" @onclick="LoadAsync">Aplicar</button>}
</section>
@if(error is not null){<div class="kb-form-error">@error</div>} @if(loading){<div class="kb-loading-state"><span class="kb-spinner"></span><span>Analizando recurrencia…</span></div>} else if(report is not null){<section class="kb-kpi-grid"><article class="kb-kpi-card kb-kpi-card--accent"><span>Tasa de recurrencia</span><strong>@report.ReturningPercentage.ToString("N1")%</strong><small>clientes activos que regresaron</small></article><article class="kb-kpi-card"><span>Clientes nuevos</span><strong>@report.NewCustomers.ToString("N0")</strong><small>primera actividad</small></article><article class="kb-kpi-card"><span>Clientes recurrentes</span><strong>@report.ReturningCustomers.ToString("N0")</strong><small>regresaron 2+ veces</small></article></section><section class="kb-report-panel"><div class="kb-panel-heading"><div><span class="kb-eyebrow">Evolución</span><h2>Nuevos vs recurrentes</h2></div></div><div class="kb-retention-legend"><span><i class="is-new"></i>Nuevos</span><span><i class="is-returning"></i>Recurrentes</span></div><div class="kb-stacked-chart">@foreach(var item in report.Trend){var total=Math.Max(1,item.NewCustomers+item.ReturningCustomers);<div class="kb-stacked-row"><span>@item.Label</span><div><i class="is-new" style="width:@($"{item.NewCustomers*100m/total:0.##}%")" title="Nuevos: @item.NewCustomers"></i><i class="is-returning" style="width:@($"{item.ReturningCustomers*100m/total:0.##}%")" title="Recurrentes: @item.ReturningCustomers"></i></div><strong>@(item.NewCustomers+item.ReturningCustomers)</strong></div>}</div></section>}
@code { private ReturningCustomersReportDto? report;private bool loading;private string? error;private string period="6m";private DateTime customStart=DateTime.UtcNow.Date.AddMonths(-6);private DateTime customEnd=DateTime.UtcNow.Date;protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;error=null;var today=DateTime.UtcNow.Date;var end=period=="custom"?DateTime.SpecifyKind(customEnd.Date.AddDays(1),DateTimeKind.Utc):today.AddDays(1);var start=period switch{"month"=>new DateTime(today.Year,today.Month,1,0,0,0,DateTimeKind.Utc),"30"=>today.AddDays(-30),"90"=>today.AddDays(-90),"custom"=>DateTime.SpecifyKind(customStart.Date,DateTimeKind.Utc),_=>today.AddMonths(-6)};var result=await Sender.Send(new GetReturningCustomersReportQuery(start,end));if(result.IsSuccess)report=result.Value;else error=result.Error;loading=false;} }
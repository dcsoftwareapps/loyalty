@page "/giftcards/reports"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.GiftCardsAuthorization.Policy)]
@rendermode InteractiveServer
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject AdminDateTimeFormatter Dates
<PageTitle>Reportes de tarjetas de regalo - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Tarjetas de regalo</span><h1>Reportes</h1><p>Monitorea emisión, canje y saldo neto durante el periodo seleccionado.</p></div></header>
<section class="kb-panel"><div class="kb-gift-filterbar"><label class="kb-field"><span>Desde</span><input type="date" @bind="from" /></label><label class="kb-field"><span>Hasta</span><input type="date" @bind="to" /></label><button class="kb-btn kb-btn--primary" disabled="@loading" @onclick="Load">@(loading?"Actualizando…":"Aplicar periodo")</button></div>@if(error is not null){<div class="kb-form-error">@error</div>}</section>
<div class="kb-metric-grid kb-gift-report-kpis"><article class="kb-metric-card"><span>Valor emitido</span><strong>@Issued.ToString("N2")</strong><small>En el periodo</small></article><article class="kb-metric-card"><span>Valor canjeado</span><strong>@Redeemed.ToString("N2")</strong><small>Uso de tarjetas de regalo</small></article><article class="kb-metric-card"><span>Saldo en circulación</span><strong>@Net.ToString("N2")</strong><small>Emitido menos canjeado en el periodo</small></article><article class="kb-metric-card"><span>Operaciones</span><strong>@Operations.ToString("N0")</strong><small>Emisiones y canjes</small></article></div>
<section class="kb-panel"><div class="kb-section-heading"><div><h2>Actividad por día</h2><p>Valores monetarios y volumen de operaciones.</p></div></div>
@if(!loading && rows.Count==0){<div class="kb-empty-state"><h2>Sin actividad en este periodo</h2><p>Amplía el rango para consultar movimientos anteriores.</p></div>}else{<div class="kb-table-shell kb-table-responsive"><table class="kb-table"><thead><tr><th>Fecha</th><th>Emitido</th><th>Canjeado</th><th>Emisiones</th><th>Canjes</th></tr></thead><tbody>@foreach(var row in rows){<tr><td data-label="Fecha">@Dates.DateNumeric(row.DateUtc)</td><td data-label="Emitido">@row.Issued.ToString("N2")</td><td data-label="Canjeado">@row.Redeemed.ToString("N2")</td><td data-label="Emisiones">@row.IssuedCount</td><td data-label="Canjes">@row.RedemptionCount</td></tr>}</tbody></table></div>}</section>
@code { DateTime from, to; bool loading; string? error; IReadOnlyList<LoyaltyCloud.Application.GiftCards.GiftCardReportPoint> rows=[]; decimal Issued=>rows.Sum(x=>x.Issued); decimal Redeemed=>rows.Sum(x=>x.Redeemed); decimal Net=>Issued-Redeemed; int Operations=>rows.Sum(x=>x.IssuedCount+x.RedemptionCount);protected override Task OnInitializedAsync(){from=Dates.LocalToday.AddDays(-30);to=Dates.LocalToday;return Load();}async Task Load(){try{loading=true;error=null;if(to<from){error="La fecha final debe ser igual o posterior a la inicial.";return;}rows=await Service.GetReportAsync(Dates.LocalDateStartToUtc(from),Dates.LocalDateExclusiveEndToUtc(to));}catch(Exception){error="No fue posible cargar el reporte. Intenta nuevamente.";}finally{loading=false;}} }

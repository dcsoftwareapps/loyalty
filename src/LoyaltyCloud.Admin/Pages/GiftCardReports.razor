@page "/giftcards/reports"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.GiftCardsAuthorization.Policy)]
@rendermode InteractiveServer
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject AdminDateTimeFormatter Dates
<PageTitle>Reportes Gift Cards - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Gift Cards</span><h1>Reportes</h1><p>Valor emitido y canjeado dentro del periodo seleccionado.</p></div></header>
<section class="kb-card"><div class="kb-filter-bar"><label>Desde<input type="date" @bind="from" /></label><label>Hasta<input type="date" @bind="to" /></label><button class="kb-button" @onclick="Load">Aplicar</button></div><div class="kb-table-wrap"><table class="kb-table"><thead><tr><th>Fecha</th><th>Emitido</th><th>Canjeado</th><th>Emisiones</th><th>Canjes</th></tr></thead><tbody>@foreach(var row in rows){<tr><td>@Dates.DateNumeric(row.DateUtc)</td><td>@row.Issued.ToString("C2")</td><td>@row.Redeemed.ToString("C2")</td><td>@row.IssuedCount</td><td>@row.RedemptionCount</td></tr>}</tbody></table></div></section>
@code { DateTime from; DateTime to; IReadOnlyList<LoyaltyCloud.Application.GiftCards.GiftCardReportPoint> rows=[]; protected override Task OnInitializedAsync(){from=Dates.LocalToday.AddDays(-30);to=Dates.LocalToday;return Load();} async Task Load()=>rows=await Service.GetReportAsync(Dates.LocalDateStartToUtc(from),Dates.LocalDateExclusiveEndToUtc(to)); }

@page "/giftcards/redeem"
@attribute [Authorize]
@rendermode InteractiveServer
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service

<PageTitle>Canjear Gift Card - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Gift Cards</span><h1>Consultar y canjear</h1><p>Escanea o escribe el código, verifica identidad y saldo antes de confirmar.</p></div></header>
<section class="kb-card"><GiftCardQrScanner OnDetected="OnScanned" /><div class="kb-form-grid"><label>Código<input @bind="code" placeholder="GC-0000-0000-0000" /></label><div><button class="kb-button" @onclick="Lookup">Consultar saldo</button></div></div>
@if(error is not null){<div class="alert alert-danger">@error</div>}
@if(detail is not null){<div class="kb-detail-grid"><div><span>Destinatario</span><strong>@detail.Card.RecipientName</strong></div><div><span>Estado</span><strong>@detail.Card.Status</strong></div><div><span>Saldo disponible</span><strong>@detail.Card.CurrentBalance.ToString("C2") @detail.Card.Currency</strong></div><div><span>Expira</span><strong>@(detail.Card.ExpiresAtUtc?.ToString("d") ?? "Sin expiración")</strong></div></div><div class="kb-gift-balance-preview"><span>Saldo actual<strong>@detail.Card.CurrentBalance.ToString("C2")</strong></span><span>Canje<strong>@amount.ToString("C2")</strong></span><span>Saldo restante<strong>@RemainingBalance.ToString("C2")</strong></span></div><label>Monto a canjear<input class="kb-gift-amount" inputmode="decimal" type="number" min="0.01" step="0.01" @bind="amount" /></label><label>Referencia (opcional)<input @bind="reference" /></label><button class="kb-button kb-button--primary" disabled="@busy" @onclick="Redeem">Confirmar canje</button>}</section>
@code { string code=""; string? error, reference; decimal amount; bool busy; LoyaltyCloud.Application.GiftCards.GiftCardDetailDto? detail; decimal RemainingBalance=>detail is null?0:Math.Max(0,detail.Card.CurrentBalance-amount); async Task OnScanned(string raw){var match=System.Text.RegularExpressions.Regex.Match(Uri.UnescapeDataString(raw??string.Empty),@"GC-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}",System.Text.RegularExpressions.RegexOptions.IgnoreCase);if(!match.Success){error="El QR no contiene un código Gift Card válido.";return;}code=match.Value.ToUpperInvariant();await Lookup();} async Task Lookup(){error=null;detail=await Service.GetByCodeAsync(code);if(detail is null)error="Gift Card no encontrada.";else amount=detail.Card.CurrentBalance;} async Task Redeem(){try{busy=true;var r=await Service.RedeemAsync(code,amount,Guid.NewGuid().ToString("N"),reference,null);error=r.Error;detail=r.Detail;}finally{busy=false;}} }

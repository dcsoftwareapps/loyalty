@page "/giftcards/redeem"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.GiftCardsAuthorization.Policy)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject LoyaltyCloud.Application.GiftCards.IGiftCardClaimService Claims
@inject AdminDateTimeFormatter Dates

<PageTitle>Canjear tarjeta de regalo - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Tarjetas de regalo</span><h1>Consultar y canjear</h1><p>Escanea o escribe el código y confirma el saldo antes de completar el canje.</p></div></header>
<section class="kb-panel kb-gift-flow">
 <div class="kb-gift-flow__step"><span>1</span><div><h2>Identifica la tarjeta</h2><p>Usa el lector o captura el código impreso.</p></div></div>
 <GiftCardQrScanner OnDetected="OnScanned" />
 <div class="kb-gift-lookup"><label class="kb-field"><span>Código de tarjeta</span><input @bind="code" placeholder="GC-0000-0000-0000" autocomplete="off" /></label><button class="kb-btn kb-btn--primary" disabled="@busy" @onclick="Lookup">Consultar saldo</button></div>
 @if(error is not null){<div class="kb-form-error" role="alert">@error</div>}
 @if(success is not null){<div class="kb-form-success" role="status">@success</div>}
 @if(detail is not null){
  <div class="kb-gift-flow__step"><span>2</span><div><h2>Verifica y confirma</h2><p>Comprueba destinatario, estado y saldo disponible.</p></div></div>
  <div class="kb-gift-summary-grid"><div><span>Destinatario</span><strong>@detail.Card.RecipientName</strong></div><div><span>Estado</span><strong>@detail.Card.Status</strong></div><div><span>Saldo disponible</span><strong>@detail.Card.CurrentBalance.ToString("N2") @detail.Card.Currency</strong></div><div><span>Expira</span><strong>@Dates.DateNumeric(detail.Card.ExpiresAtUtc, "Sin expiración")</strong></div></div>
  <EditForm Model="model" OnValidSubmit="Redeem"><DataAnnotationsValidator /><ValidationSummary class="kb-form-error" />
   <div class="kb-form-grid"><label class="kb-field"><span>Monto a canjear</span><InputNumber @bind-Value="model.Amount" min="0.01" step="0.01" /><ValidationMessage For="@(()=>model.Amount)" /></label><label class="kb-field"><span>Referencia <small>(opcional)</small></span><InputText @bind-Value="model.Reference" maxlength="150" /></label></div>
   <div class="kb-gift-balance-preview"><span>Saldo actual<strong>@detail.Card.CurrentBalance.ToString("N2")</strong></span><span>Canje<strong>@model.Amount.ToString("N2")</strong></span><span>Saldo restante<strong>@RemainingBalance.ToString("N2")</strong></span></div>
   <button class="kb-btn kb-btn--primary" disabled="@busy" type="submit">@(busy ? "Procesando…" : "Confirmar canje")</button>
  </EditForm>
 }
</section>
@code {
 string code=""; string? error,success; bool busy; RedeemModel model=new(); LoyaltyCloud.Application.GiftCards.GiftCardDetailDto? detail;
 decimal RemainingBalance=>detail is null?0:Math.Max(0,detail.Card.CurrentBalance-model.Amount);
 async Task OnScanned(string raw){var decoded=Uri.UnescapeDataString(raw??string.Empty);var match=System.Text.RegularExpressions.Regex.Match(decoded,@"GC-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}",System.Text.RegularExpressions.RegexOptions.IgnoreCase);if(match.Success){code=match.Value.ToUpperInvariant();await Lookup();return;}if(Uri.TryCreate(decoded,UriKind.Absolute,out var uri)){var marker="/giftcards/claim/";var index=uri.AbsolutePath.IndexOf(marker,StringComparison.OrdinalIgnoreCase);if(index>=0){var token=Uri.UnescapeDataString(uri.AbsolutePath[(index+marker.Length)..]);var claim=await Claims.GetAsync(token);if(claim is not null){code=claim.Card.Code;await Lookup();return;}}}error="Este QR no contiene una tarjeta de regalo válida.";}
 async Task Lookup(){try{busy=true;error=success=null;detail=await Service.GetByCodeAsync(code.Trim());if(detail is null){error="No encontramos una tarjeta de regalo con ese código.";return;}model.Amount=detail.Card.CurrentBalance;}catch(Exception){error="No fue posible consultar o procesar la tarjeta de regalo. Intenta nuevamente.";}finally{busy=false;}}
 async Task Redeem(){if(detail is null)return;try{busy=true;error=success=null;var r=await Service.RedeemAsync(code,model.Amount,Guid.NewGuid().ToString("N"),model.Reference,null);if(!r.Success){error=r.Error??"No fue posible completar el canje.";return;}detail=r.Detail;success="Canje completado correctamente.";model.Amount=0;}catch(Exception){error="No fue posible consultar o procesar la tarjeta de regalo. Intenta nuevamente.";}finally{busy=false;}}
 sealed class RedeemModel{[Range(typeof(decimal),"0.01","999999999",ErrorMessage="Ingresa un monto mayor a cero.")]public decimal Amount{get;set;} public string? Reference{get;set;}}
}

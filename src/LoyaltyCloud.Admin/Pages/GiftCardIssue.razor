@page "/giftcards/issue"
@attribute [Authorize]
@rendermode InteractiveServer
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject LoyaltyCloud.Application.GiftCards.IGiftCardDeliveryService Delivery

<PageTitle>Emitir Gift Card - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Gift Cards</span><h1>Emitir Gift Card</h1><p>Registra una venta externa, cortesía o compensación. LoyaltyCloud no procesa el cobro.</p></div></header>
@if (result is not null) { <section class="kb-card"><h2>Gift Card emitida</h2><p><strong>@result.Card.Code</strong> · @result.Card.CurrentBalance.ToString("C2") @result.Card.Currency</p><p>Token seguro para enlace de entrega:</p><code>@result.ClaimToken</code><div class="kb-actions"><a class="kb-button" href="/giftcards/cards/@result.Card.Id">Ver detalle</a>@if(!string.IsNullOrWhiteSpace(result.Card.RecipientEmail)){<button class="kb-button" @onclick="SendEmail">Enviar por email</button>}<button class="kb-button kb-button--primary" @onclick="Reset">Emitir otra</button></div>@if(deliveryMessage is not null){<p>@deliveryMessage</p>}</section> }
else { <section class="kb-card"><div class="kb-form-grid"><label>Monto<input type="number" step="0.01" min="0.01" @bind="amount" /></label><label>Nombre del destinatario<input @bind="recipientName" /></label><label>Email (opcional)<input type="email" @bind="email" /></label><label>Teléfono (opcional)<input @bind="phone" /></label><label>Nombre del remitente<input @bind="sender" /></label><label>Origen<select @bind="source"><option value="PurchasedExternally">Compra registrada externamente</option><option value="Promotional">Promocional</option><option value="Manual">Manual</option><option value="Compensation">Compensación</option></select></label><label class="kb-field--wide">Mensaje<textarea @bind="message"></textarea></label></div>@if(error is not null){<div class="alert alert-danger">@error</div>}<button class="kb-button kb-button--primary" disabled="@busy" @onclick="Issue">@(busy?"Emitiendo…":"Emitir Gift Card")</button></section> }
@code { decimal amount; string recipientName=""; string? email,phone,sender,message,error,deliveryMessage; string source="PurchasedExternally"; bool busy; LoyaltyCloud.Application.GiftCards.IssuedGiftCardDto? result; async Task SendEmail(){try{await Delivery.SendEmailAsync(result!,result!.Card.RecipientEmail!);deliveryMessage="Email enviado.";}catch(Exception ex){deliveryMessage=ex.Message;}} async Task Issue(){try{busy=true;error=null;result=await Service.IssueAsync(new(amount,null,recipientName,email,phone,sender,message,Enum.Parse<LoyaltyCloud.Domain.Enums.GiftCardSource>(source),null));}catch(Exception ex){error=ex.Message;}finally{busy=false;}} void Reset(){result=null;amount=0;recipientName="";email=phone=sender=message=null;} }

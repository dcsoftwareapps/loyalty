@page "/reports/level-distribution"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISender Sender
<PageTitle>Distribución por nivel - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Reportes avanzados</span><h1>Distribución por nivel</h1><p>Conoce la composición de tu comunidad y la profundidad de fidelización.</p></div></header><ReportSubnav />
@if(error is not null){<div class="kb-form-error">@error</div>} @if(loading){<div class="kb-loading-state"><span class="kb-spinner"></span><span>Analizando niveles…</span></div>} else if(report is not null){<section class="kb-kpi-grid"><article class="kb-kpi-card"><span>Clientes activos</span><strong>@report.TotalCustomers.ToString("N0")</strong><small>con tarjeta vigente</small></article><article class="kb-kpi-card"><span>Nivel dominante</span><strong class="kb-kpi-text">@(report.DominantLevel??"Sin datos")</strong><small>mayor comunidad</small></article><article class="kb-kpi-card kb-kpi-card--accent"><span>En nivel superior</span><strong>@report.TopLevelPercentage.ToString("N1")%</strong><small>de la base activa</small></article></section>@if(report.Levels.Count==0){<div class="kb-empty-state"><h3>Aún no hay niveles con clientes</h3><p>La distribución aparecerá cuando existan tarjetas activas.</p></div>}else{<section class="kb-report-panel"><div class="kb-panel-heading"><div><span class="kb-eyebrow">Composición actual</span><h2>Clientes por nivel</h2></div></div><ReportBarChart Labels="@report.Levels.Select(x=>x.Level).ToList()" Values="@report.Levels.Select(x=>(decimal)x.Customers).ToList()" AriaLabel="Distribución de clientes por nivel" /></section><div class="kb-table-shell"><div class="kb-table-responsive"><table class="kb-table"><thead><tr><th>Nivel</th><th class="kb-cell-number">Clientes</th><th class="kb-cell-number">Participación</th><th class="kb-cell-number">Puntos promedio</th></tr></thead><tbody>@foreach(var item in report.Levels){<tr><td><span class="kb-level kb-level--neutral">@item.Level</span></td><td class="kb-cell-number">@item.Customers.ToString("N0")</td><td class="kb-cell-number">@item.Percentage.ToString("N1")%</td><td class="kb-cell-number">@item.AveragePoints.ToString("N0")</td></tr>}</tbody></table></div></div>}}
@code {private LevelDistributionReportDto? report;private bool loading;private string? error;protected override async Task OnInitializedAsync(){loading=true;var result=await Sender.Send(new GetLevelDistributionReportQuery());if(result.IsSuccess)report=result.Value;else error=result.Error;loading=false;}}
@page "/redeem"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Text.RegularExpressions
@using LoyaltyCloud.Admin.Services
@using LoyaltyCloud.Common.Constants
@using LoyaltyCloud.Application.Config.Queries.GetProgramConfig
@using LoyaltyCloud.Application.Customers.Queries.GetCustomerBySerial
@using LoyaltyCloud.Application.Redemptions.Commands.RedeemReward
@using LoyaltyCloud.Application.Redemptions.Queries.GetRedemptionCatalog
@inject AdminApiClient AdminApi
@inject IJSRuntime JS
@inject ILogger<Redeem> Logger

<PageTitle>Canjear - LoyaltyCloud</PageTitle>

<div class="kb-scan" style="max-width:720px;">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:20px;">
        <div>
            <h1>Canjear</h1>
            <p class="kb-muted" style="margin-top:-8px;">Escanea el QR de Wallet y elige una recompensa disponible.</p>
        </div>
        <a class="kb-btn kb-btn--ghost" href="/redemptions">Historial</a>
    </div>

    @if (customer is null)
    {
        <section class="kb-card">
            <div class="kb-form-row">
                <button class="kb-btn kb-btn--secondary kb-btn--large kb-btn--block"
                        @onclick="StartScannerAsync"
                        disabled="@(busy || scanning)">
                    @(scanning ? "Escaneando..." : "Escanear QR")
                </button>

                @if (scanning)
                {
                    <div class="kb-qr-scanner">
                        <video @ref="qrVideo" class="kb-qr-video" autoplay muted playsinline></video>
                        <p>Apunta al codigo QR de la tarjeta de lealtad</p>
                        <button class="kb-btn kb-btn--ghost kb-btn--block" @onclick="CancelScannerAsync">
                            Cancelar
                        </button>
                    </div>
                }

                @if (scannerMessage is not null)
                {
                    <div class="kb-form-success">@scannerMessage</div>
                }

                <div>
                    <label for="serial">ID del cliente</label>
                    <input id="serial" type="text" @bind="serialInput" @bind:event="oninput"
                           @onkeydown="HandleSerialKeyDownAsync"
                           placeholder="KB-A7B9C2X" autocomplete="off" />
                </div>
                <button class="kb-btn kb-btn--primary kb-btn--large kb-btn--block"
                        @onclick="LoadCatalogAsync" disabled="@(string.IsNullOrWhiteSpace(serialInput) || busy)">
                    @(busy ? "Buscando..." : "Buscar cliente")
                </button>
            </div>
        </section>
    }
    else
    {
        <CustomerCard Customer="customer" />

        @if (success is not null)
        {
            <div class="kb-form-success" style="margin-top:18px;">
                <strong>Canje realizado correctamente.</strong>
                <div>@FormatSuccess(success)</div>
                <div>Nuevo saldo: @success.RemainingPoints.ToString("N0") pts</div>
            </div>
        }

        <section class="kb-card" style="margin-top:18px;">
            <h2>Tipo de canje</h2>
            <div class="kb-segmented" role="radiogroup" aria-label="Tipo de canje">
                <label class="kb-choice">
                    <input type="radio" name="redemption-type" checked="@(redemptionMode == RedemptionMode.MonetaryDiscount)"
                           @onchange="@(() => SetMode(RedemptionMode.MonetaryDiscount))" />
                    <span>Descuento en dinero</span>
                </label>
                <label class="kb-choice">
                    <input type="radio" name="redemption-type" checked="@(redemptionMode == RedemptionMode.CatalogReward)"
                           @onchange="@(() => SetMode(RedemptionMode.CatalogReward))" />
                    <span>Recompensa</span>
                </label>
            </div>
        </section>

        @if (redemptionMode == RedemptionMode.MonetaryDiscount)
        {
            <section class="kb-card" style="margin-top:18px;border-color:var(--kb-blush);">
                <h2>Descuento en dinero</h2>
                <DetailItem Label="Saldo disponible" Value="@($"{customer.CurrentPoints:N0} pts")" />
                <DetailItem Label="Valor disponible aproximado" Value="@FormatMoney(AvailableMonetaryAmount)" />
                <DetailItem Label="Tasa" Value="@RateLabel" />

                <div class="kb-form-row" style="margin-top:16px;">
                    <div>
                        <label for="monetary-points">Puntos a canjear</label>
                        <input id="monetary-points" type="number" min="0" step="@PointUnit"
                               @bind="monetaryPoints" @bind:event="oninput" />
                    </div>
                    <button type="button" class="kb-btn kb-btn--ghost" @onclick="UseAllPoints" disabled="@(busy || UsablePoints <= 0)">
                        Usar todos
                    </button>
                </div>

                <div style="margin-top:14px;">
                    <span class="kb-muted">Descuento:</span>
                    <strong style="display:block;font-size:1.45rem;">@FormatMoney(MonetaryDiscountAmount)</strong>
                    <p class="kb-muted" style="margin-bottom:0;">Aplica este importe manualmente en la caja/POS antes de confirmar.</p>
                </div>

                @if (MonetaryValidationError is not null)
                {
                    <div class="kb-form-error" style="margin-top:14px;">@MonetaryValidationError</div>
                }

                <button class="kb-btn kb-btn--primary kb-btn--large kb-btn--block" style="margin-top:16px;"
                        @onclick="ConfirmMonetaryRedemptionAsync"
                        disabled="@(busy || MonetaryValidationError is not null)">
                    @(busy ? "Procesando..." : $"Canjear {monetaryPoints:N0} puntos por {FormatMoney(MonetaryDiscountAmount)}")
                </button>
            </section>
        }

        @if (redemptionMode == RedemptionMode.CatalogReward && selectedReward is not null)
        {
            <section class="kb-card" style="margin-top:18px;border-color:var(--kb-blush);">
                <h2>Confirmar canje</h2>
                <DetailItem Label="Canjear" Value="@selectedReward.Name" />
                <DetailItem Label="Puntos" Value="@($"{selectedReward.PointsCost:N0} puntos")" />
                <DetailItem Label="Cliente" Value="@customer.FullName" />
                <DetailItem Label="Saldo actual" Value="@($"{customer.CurrentPoints:N0} pts")" />
                <DetailItem Label="Saldo estimado despues" Value="@($"{Math.Max(0, customer.CurrentPoints - selectedReward.PointsCost):N0} pts")" />

                <div class="kb-actions-inline" style="margin-top:16px;">
                    <button class="kb-btn kb-btn--primary kb-btn--large" @onclick="ConfirmRedemptionAsync" disabled="@busy">
                        @(busy ? "Procesando..." : "Confirmar canje")
                    </button>
                    <button class="kb-btn kb-btn--ghost kb-btn--large" @onclick="@(() => selectedReward = null)" disabled="@busy">
                        Cancelar
                    </button>
                </div>
            </section>
        }

        @if (redemptionMode == RedemptionMode.CatalogReward && availableRewards.Count > 0)
        {
            <section style="margin-top:24px;">
                <h2>Disponibles</h2>
                <div class="kb-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
                    @foreach (var reward in availableRewards)
                    {
                        <article class="kb-card">
                            <h3 style="margin-top:0;">@reward.Name</h3>
                            <p class="kb-muted">@reward.Description</p>
                            <strong>@reward.PointsCost.ToString("N0") pts</strong>
                            @if (reward.IsMonthlyProduct)
                            {
                                <span class="kb-badge kb-badge--info" style="margin-left:8px;">Producto del mes</span>
                            }
                            <button class="kb-btn kb-btn--primary kb-btn--block" style="margin-top:14px;"
                                    @onclick="@(() => SelectReward(reward))"
                                    disabled="@(busy || selectedReward is not null)">
                                Canjear
                            </button>
                        </article>
                    }
                </div>
            </section>
        }

        @if (redemptionMode == RedemptionMode.CatalogReward && unavailableRewards.Count > 0)
        {
            <section style="margin-top:24px;">
                <h2>No disponibles</h2>
                <div class="kb-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
                    @foreach (var reward in unavailableRewards)
                    {
                        <article class="kb-card" style="opacity:.82;">
                            <h3 style="margin-top:0;">@reward.Name</h3>
                            <p class="kb-muted">@reward.Description</p>
                            <strong>@reward.PointsCost.ToString("N0") pts</strong>
                            <p class="kb-muted" style="margin-bottom:0;">Te faltan @Math.Max(0, reward.PointsCost - customer.CurrentPoints).ToString("N0") puntos</p>
                        </article>
                    }
                </div>
            </section>
        }

        @if (redemptionMode == RedemptionMode.CatalogReward && catalog is not null && catalog.Count == 0)
        {
            <p class="kb-muted" style="text-align:center;margin-top:24px;">No hay recompensas disponibles para este cliente.</p>
        }

        <button class="kb-btn kb-btn--ghost kb-btn--block" style="margin-top:24px;" @onclick="Reset" disabled="@busy">
            Escanear otro cliente
        </button>
    }

    @if (errorMessage is not null)
    {
        <div class="kb-form-error" style="margin-top:18px;">@errorMessage</div>
    }
</div>

@code {
    private static readonly Regex SerialRegex = new(@"KB-[A-Z0-9]{7}", RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private string serialInput = string.Empty;
    private CustomerDetailDto? customer;
    private IReadOnlyList<RewardCatalogItemDto>? catalog;
    private RewardCatalogItemDto? selectedReward;
    private RedemptionResponse? success;
    private RedemptionMode redemptionMode = RedemptionMode.MonetaryDiscount;
    private decimal? pointsPerPesoUnit;
    private int monetaryPoints;
    private string? errorMessage;
    private string? scannerMessage;
    private bool busy;
    private bool scanning;
    private bool qrDetected;
    private bool scannerStarted;
    private ElementReference qrVideo;
    private DotNetObjectReference<Redeem>? dotNetRef;

    private IReadOnlyList<RewardCatalogItemDto> availableRewards =>
        catalog?.Where(r => r.CanAfford).ToList() ?? [];

    private IReadOnlyList<RewardCatalogItemDto> unavailableRewards =>
        catalog?.Where(r => !r.CanAfford).ToList() ?? [];

    private int PointUnit => pointsPerPesoUnit.HasValue && pointsPerPesoUnit.Value > 0
        && decimal.Truncate(pointsPerPesoUnit.Value) == pointsPerPesoUnit.Value
        && pointsPerPesoUnit.Value <= int.MaxValue
            ? (int)pointsPerPesoUnit.Value
            : 0;

    private int UsablePoints => customer is null || PointUnit <= 0
        ? 0
        : customer.CurrentPoints - (customer.CurrentPoints % PointUnit);

    private decimal AvailableMonetaryAmount => pointsPerPesoUnit.GetValueOrDefault() > 0
        ? decimal.Round(UsablePoints / pointsPerPesoUnit.GetValueOrDefault(), 2, MidpointRounding.AwayFromZero)
        : 0;

    private decimal MonetaryDiscountAmount => pointsPerPesoUnit.GetValueOrDefault() > 0
        ? decimal.Round(monetaryPoints / pointsPerPesoUnit.GetValueOrDefault(), 2, MidpointRounding.AwayFromZero)
        : 0;

    private string RateLabel => PointUnit > 0
        ? $"{PointUnit:N0} puntos = $1.00 MXN"
        : "Configuracion no disponible";

    private string? MonetaryValidationError
    {
        get
        {
            if (customer is null)
                return "Busca un cliente antes de canjear.";
            if (PointUnit <= 0 || pointsPerPesoUnit is null)
                return "La configuracion de canje no es valida.";
            if (monetaryPoints <= 0)
                return "Los puntos a canjear deben ser mayores a 0.";
            if (monetaryPoints > customer.CurrentPoints)
                return $"Saldo insuficiente: el cliente tiene {customer.CurrentPoints:N0} puntos.";
            if (monetaryPoints % PointUnit != 0)
                return $"Los puntos deben canjearse en multiplos de {PointUnit:N0}.";
            if (MonetaryDiscountAmount <= 0)
                return "El descuento calculado debe ser mayor a $0.00 MXN.";

            return null;
        }
    }

    private async Task StartScannerAsync()
    {
        errorMessage = null;
        scannerMessage = null;
        scanning = true;
        qrDetected = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        dotNetRef ??= DotNetObjectReference.Create(this);

        var result = await JS.InvokeAsync<QrScannerStartResult>(
            "kbeautyQrScanner.start",
            qrVideo,
            dotNetRef);

        if (!result.Ok)
        {
            scanning = false;
            errorMessage = result.Message ?? "No se pudo acceder a la camara. Puedes ingresar el ID del cliente manualmente.";
            scannerStarted = false;
            return;
        }

        scannerStarted = true;
    }

    private async Task CancelScannerAsync()
    {
        await StopScannerAsync();
        scannerMessage = null;
        qrDetected = false;
    }

    [JSInvokable]
    public async Task OnQrDetected(string rawValue)
    {
        await InvokeAsync(async () =>
        {
            if (qrDetected)
                return;

            qrDetected = true;
            await StopScannerAsync();

            var serial = ExtractSerial(rawValue);
            if (serial is null)
            {
                errorMessage = "Codigo QR no valido para LoyaltyCloud.";
                scannerMessage = null;
                qrDetected = false;
                StateHasChanged();
                return;
            }

            serialInput = serial;
            scannerMessage = $"QR detectado: {serial}";
            await LoadCatalogAsync();
            StateHasChanged();
        });
    }

    private async Task HandleSerialKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        var serial = ExtractSerial(serialInput);
        if (serial is null)
        {
            errorMessage = "Ingresa un ID del cliente valido, por ejemplo KB-A7B9C2X.";
            return;
        }

        serialInput = serial;
        errorMessage = null;
        success = null;
        selectedReward = null;
        busy = true;
        var operation = "customer";

        try
        {
            operation = "customer";
            var customerResult = await AdminApi.GetAsync<CustomerDetailDto>($"api/customers/{Uri.EscapeDataString(serial)}");
            if (customerResult.IsFailure)
            {
                Logger.LogWarning(
                    "Redeem customer lookup API returned failure. Operation={Operation} Serial={Serial} Error={Error}",
                    operation,
                    serial,
                    customerResult.Error);
                errorMessage = customerResult.Error;
                return;
            }

            operation = "catalog";
            var catalogResult = await AdminApi.GetAsync<IReadOnlyList<RewardCatalogItemDto>>($"api/redemptions/catalog/{Uri.EscapeDataString(serial)}");
            if (catalogResult.IsFailure)
            {
                Logger.LogWarning(
                    "Redeem customer lookup API returned failure. Operation={Operation} Serial={Serial} Error={Error}",
                    operation,
                    serial,
                    catalogResult.Error);
                errorMessage = catalogResult.Error;
                return;
            }

            operation = "config";
            var configResult = await AdminApi.GetAsync<IReadOnlyList<ConfigDto>>("api/config");
            if (configResult.IsFailure)
            {
                Logger.LogWarning(
                    "Redeem customer lookup API returned failure. Operation={Operation} Serial={Serial} Error={Error}",
                    operation,
                    serial,
                    configResult.Error);
                errorMessage = configResult.Error;
                return;
            }

            customer = customerResult.Value;
            catalog = catalogResult.Value;
            pointsPerPesoUnit = ReadPointsPerPesoUnit(configResult.Value);
            monetaryPoints = 0;
            redemptionMode = RedemptionMode.MonetaryDiscount;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Redeem customer lookup failed. Operation={Operation} Serial={Serial}",
                operation,
                serial);
            errorMessage = "Ocurrió un error inesperado.";
        }
        finally
        {
            busy = false;
            qrDetected = false;
        }
    }

    private void SelectReward(RewardCatalogItemDto reward)
    {
        if (!reward.CanAfford || busy)
            return;

        selectedReward = reward;
        errorMessage = null;
    }

    private void SetMode(RedemptionMode mode)
    {
        redemptionMode = mode;
        selectedReward = null;
        success = null;
        errorMessage = null;
    }

    private void UseAllPoints()
    {
        monetaryPoints = UsablePoints;
        errorMessage = null;
    }

    private async Task ConfirmMonetaryRedemptionAsync()
    {
        if (customer is null || busy || MonetaryValidationError is not null)
            return;

        errorMessage = null;
        busy = true;

        try
        {
            var serial = customer.SerialNumber;
            var result = await AdminApi.PostAsJsonAsync<RedeemRedemptionRequest, RedemptionResponse>(
                "api/redemptions",
                new RedeemRedemptionRequest(serial, null, "MonetaryDiscount", monetaryPoints));

            if (result.IsFailure)
            {
                errorMessage = result.Error;
                return;
            }

            success = result.Value;
            monetaryPoints = 0;
            await RefreshAfterRedemptionAsync(serial);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmRedemptionAsync()
    {
        if (selectedReward is null || customer is null || busy)
            return;

        errorMessage = null;
        busy = true;

        try
        {
            var serial = customer.SerialNumber;
            var result = await AdminApi.PostAsJsonAsync<RedeemRedemptionRequest, RedemptionResponse>(
                "api/redemptions",
                new RedeemRedemptionRequest(serial, selectedReward.Id));

            if (result.IsFailure)
            {
                errorMessage = result.Error;
                return;
            }

            success = result.Value;
            selectedReward = null;
            await RefreshAfterRedemptionAsync(serial);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RefreshAfterRedemptionAsync(string serial)
    {
        var customerResult = await AdminApi.GetAsync<CustomerDetailDto>($"api/customers/{Uri.EscapeDataString(serial)}");
        if (customerResult.IsSuccess)
            customer = customerResult.Value;
        else
            errorMessage = $"El canje se registro, pero no se pudo refrescar el saldo: {customerResult.Error}";

        var catalogResult = await AdminApi.GetAsync<IReadOnlyList<RewardCatalogItemDto>>($"api/redemptions/catalog/{Uri.EscapeDataString(serial)}");
        if (catalogResult.IsSuccess)
            catalog = catalogResult.Value;
    }

    private void Reset()
    {
        customer = null;
        catalog = null;
        selectedReward = null;
        success = null;
        redemptionMode = RedemptionMode.MonetaryDiscount;
        monetaryPoints = 0;
        pointsPerPesoUnit = null;
        serialInput = string.Empty;
        errorMessage = null;
        scannerMessage = null;
        qrDetected = false;
    }

    private async Task StopScannerAsync()
    {
        scanning = false;
        if (!scannerStarted)
            return;

        scannerStarted = false;

        try
        {
            await JS.InvokeVoidAsync("kbeautyQrScanner.stop");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string? ExtractSerial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var decoded = Uri.UnescapeDataString(value.Trim()).ToUpperInvariant();
        var match = SerialRegex.Match(decoded);
        return match.Success ? match.Value.ToUpperInvariant() : null;
    }

    private static decimal? ReadPointsPerPesoUnit(IReadOnlyList<ConfigDto> entries)
    {
        var raw = entries.FirstOrDefault(e =>
            string.Equals(e.Key, LoyaltyConstants.ConfigKeys.PointsPerPesoUnit, StringComparison.OrdinalIgnoreCase))?.Value;

        return decimal.TryParse(raw, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? value
            : null;
    }

    private static string FormatMoney(decimal value) => $"${value:N2} MXN";

    private static string FormatSuccess(RedemptionResponse response) =>
        response.MonetaryAmount.HasValue
            ? $"Descuento en dinero - {response.PointsSpent:N0} pts -> {FormatMoney(response.MonetaryAmount.Value)}"
            : $"{response.RewardName} - {response.PointsSpent:N0} pts";

    public async ValueTask DisposeAsync()
    {
        await StopScannerAsync();
        dotNetRef?.Dispose();
    }

    private enum RedemptionMode
    {
        MonetaryDiscount,
        CatalogReward
    }

    private sealed record RedeemRedemptionRequest(
        string SerialNumber,
        Guid? RewardCatalogItemId = null,
        string? Type = null,
        int? PointsToRedeem = null);
    private sealed record QrScannerStartResult(bool Ok, string? Message);
}

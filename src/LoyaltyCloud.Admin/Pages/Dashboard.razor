@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer

@using LoyaltyCloud.Application.Admin.Queries.GetDashboardSummary
@inject ISender Sender

<PageTitle>Dashboard - LoyaltyCloud</PageTitle>

<div class="kb-page-header">
    <div>
        <span class="kb-eyebrow">Vista general</span>
        <h1>Dashboard</h1>
        <p>Resumen de tu programa de lealtad y su actividad reciente.</p>
    </div>
    <a class="kb-btn kb-btn--primary" href="/scan"><NavIcon Name="plus" /> Agregar puntos</a>
</div>

@if (errorMsg is not null)
{
    <div class="kb-form-error" role="alert">@errorMsg</div>
}
else if (dashboard is null)
{
    <div class="kb-loading-state" role="status"><span class="kb-spinner"></span><span>Cargando resumen…</span></div>
}
else
{
    <section class="kb-dashboard-primary" aria-labelledby="overview-title">
        <div class="kb-section-heading">
            <div><h2 id="overview-title">Rendimiento general</h2><p>Los indicadores clave de tu programa.</p></div>
        </div>
        <div class="kb-metric-grid">
            <MetricCard Label="Clientes registrados" Value="@FormatNumber(dashboard.Customers.TotalCustomers)" Icon="users" Context="@($"{FormatNumber(dashboard.Customers.NewCustomersThisMonth)} nuevos este mes")" />
            <MetricCard Label="Clientes activos" Value="@FormatNumber(dashboard.Customers.ActiveCustomers)" Icon="spark" Context="Con actividad en el programa" />
            <MetricCard Label="Puntos en circulación" Value="@FormatNumber(dashboard.Points.CurrentPointBalance)" Icon="levels" Context="@($"{FormatNumber(dashboard.Points.PointsIssued)} emitidos históricamente")" />
            <MetricCard Label="Wallets emitidas" Value="@FormatNumber(dashboard.Customers.CustomersWithWallet)" Icon="card" Context="Clientes con tarjeta digital" />
        </div>
    </section>

    <div class="kb-dashboard-layout">
        <section class="kb-panel kb-quick-actions" aria-labelledby="actions-title">
            <div class="kb-panel-heading"><div><h2 id="actions-title">Acciones rápidas</h2><p>Continúa con las tareas más frecuentes.</p></div></div>
            <div class="kb-action-list">
                <a href="/scan"><span class="kb-action-icon"><NavIcon Name="plus" /></span><span><strong>Agregar puntos</strong><small>Registra una compra o visita</small></span><span class="kb-action-arrow">→</span></a>
                <a href="/redeem"><span class="kb-action-icon"><NavIcon Name="scan" /></span><span><strong>Canjear puntos</strong><small>Escanea y aplica una recompensa</small></span><span class="kb-action-arrow">→</span></a>
                <a href="/customers"><span class="kb-action-icon"><NavIcon Name="users" /></span><span><strong>Ver clientes</strong><small>Consulta saldos e historial</small></span><span class="kb-action-arrow">→</span></a>
            </div>
        </section>

        <section class="kb-panel kb-program-health" aria-labelledby="program-title">
            <div class="kb-panel-heading"><div><h2 id="program-title">Estado del programa</h2><p>Distribución operativa actual.</p></div></div>
            <dl class="kb-stat-list">
                <div><dt>Canjes pendientes</dt><dd>@FormatNumber(dashboard.Redemptions.Pending)</dd></div>
                <div><dt>Canjes confirmados</dt><dd>@FormatNumber(dashboard.Redemptions.Confirmed)</dd></div>
                <div><dt>Recompensas activas</dt><dd>@FormatNumber(dashboard.Rewards.Active)</dd></div>
                <div><dt>Puntos canjeados</dt><dd>@FormatNumber(dashboard.Points.PointsRedeemed)</dd></div>
            </dl>
        </section>
    </div>

    <section class="kb-panel kb-activity-panel" aria-labelledby="activity-title">
        <div class="kb-panel-heading">
            <div><h2 id="activity-title">Actividad reciente</h2><p>Los últimos movimientos registrados en tu programa.</p></div>
            <a href="/customers" class="kb-text-link">Ver clientes <span aria-hidden="true">→</span></a>
        </div>
        @if (dashboard.RecentActivity.Count == 0)
        {
            <div class="kb-empty-state">
                <span class="kb-empty-icon"><NavIcon Name="history" /></span>
                <h3>Aún no hay actividad</h3>
                <p>Las operaciones recientes de tus clientes aparecerán aquí.</p>
                <a class="kb-btn kb-btn--ghost kb-btn--small" href="/scan">Registrar primera operación</a>
            </div>
        }
        else
        {
            <div class="kb-table-responsive">
                <table class="kb-table kb-table--compact">
                    <thead><tr><th>Actividad</th><th>Cliente</th><th class="kb-cell-number">Puntos</th><th>Estado</th><th>Fecha</th></tr></thead>
                    <tbody>
                    @foreach (var item in dashboard.RecentActivity)
                    {
                        <tr>
                            <td data-label="Actividad"><div class="kb-activity-type"><span class="kb-activity-dot"></span><div><strong>@item.Type</strong><small>@item.Description</small></div></div></td>
                            <td data-label="Cliente"><strong>@item.CustomerName</strong><small class="kb-table-secondary">@item.SerialNumber</small></td>
                            <td data-label="Puntos" class="kb-cell-number"><span class="kb-points-change @(item.Points >= 0 ? "kb-points-change--positive" : "kb-points-change--negative")">@(item.Points > 0 ? "+" : "")@item.Points.ToString("N0")</span></td>
                            <td data-label="Estado"><span class="kb-badge kb-badge--muted">@DisplayText(item.Status)</span></td>
                            <td data-label="Fecha" class="kb-muted">@item.OccurredAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private DashboardSummaryDto? dashboard;
    private string? errorMsg;

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetDashboardSummaryQuery());
        if (result.IsSuccess) dashboard = result.Value;
        else errorMsg = result.Error;
    }

    private static string FormatNumber(int value) => value.ToString("N0");
    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "Sin estado" : value;
}

@page "/stamps"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.TenantAuthorizationPolicies.TenantAdmin)]
@rendermode InteractiveServer
@using LoyaltyCloud.Application.Stamps
@using LoyaltyCloud.Domain.Enums
@inject ISender Sender
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantProgramReadService Programs
@inject IStampVisualService Visuals
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject LoyaltyCloud.Admin.Auth.AdminCurrentUserService CurrentUser

<PageTitle>Sellos - LoyaltyCloud</PageTitle>

<header class="kb-page-header"><div><h1>Sellos</h1></div></header>
@if (loading) { <p>Cargando...</p> }
else if (!isStamps) { <p>Este programa no está disponible para tu negocio.</p> }
else
{
    @if (current is null) { <h2>Configura tu programa de sellos</h2> }
    else { <p class="kb-muted">Los cambios aplicarán a las nuevas tarjetas y ciclos. Las tarjetas actuales conservarán sus reglas.</p> }
    @if (error is not null) { <div class="kb-form-error" role="alert">@error</div> }
    @if (success is not null) { <div class="kb-form-success" role="status">@success</div> }
    @foreach (var message in errors) { <div class="kb-form-error" role="alert">@message</div> }
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <fieldset disabled="@(busy || visualBusy)" class="kb-stamp-form">
            <section class="kb-stamp-section">
            <h2>Reglas del programa</h2>
            <div class="kb-form-row">
                <label for="stamp-max">Sellos para completar tarjeta</label>
                <input id="stamp-max" type="number" min="2" max="12" step="1" @bind="maxStamps" />
            </div>
            <div class="kb-form-row">
                <label for="stamp-welcome">Sellos de bienvenida</label>
                <input id="stamp-welcome" type="number" min="0" max="@(maxStamps - 1)" step="1" @bind="welcomeStamps" />
                <small class="kb-muted">Se otorgan una sola vez al registrar al cliente.</small>
            </div>
            <div class="kb-form-row">
                <label for="stamp-reversal">Permitir cancelar el último sello</label>
                <select id="stamp-reversal" @bind="policy">
                    <option value="@StampReversalPolicy.None">No permitir</option>
                    <option value="@StampReversalPolicy.AdminOnly">Administradores</option>
                    <option value="@StampReversalPolicy.AdminAndCashier">Administradores y cajeros</option>
                </select>
            </div>
            </section>
            <section class="kb-stamp-section">
            <h2>Recompensas</h2>
            <p class="kb-muted">Agrega una recompensa para el último sello de la tarjeta.</p>
            <p id="stamp-short-help" class="kb-muted">El nombre corto se usa en las notificaciones de Wallet. Procura que sea breve, por ejemplo: Café gratis.</p>
            @for (var i = 0; i < rewards.Count; i++)
            {
                var reward = rewards[i];
                var index = i;
                <div class="kb-stamp-reward" @key="reward">
                    <div class="kb-field"><label for="@($"stamp-threshold-{index}")">Sello</label><input id="@($"stamp-threshold-{index}")" type="number" min="1" max="@maxStamps" @bind="reward.RequiredStamps" /></div>
                    <div class="kb-field"><label for="@($"stamp-name-{index}")">Nombre</label><input id="@($"stamp-name-{index}")" maxlength="150" @bind="reward.Name" required /></div>
                    <div class="kb-field"><label for="@($"stamp-short-name-{index}")">Nombre corto</label><input id="@($"stamp-short-name-{index}")" maxlength="40" @bind="reward.ShortName" required aria-describedby="stamp-short-help" /></div>
                    <div class="kb-field"><label for="@($"stamp-description-{index}")">Descripción (opcional)</label><textarea id="@($"stamp-description-{index}")" maxlength="1000" rows="2" @bind="reward.Description"></textarea></div>
                    <button type="button" class="kb-icon-button" title="Eliminar recompensa" aria-label="Eliminar recompensa" @onclick="() => rewards.Remove(reward)"><NavIcon Name="close" /></button>
                </div>
            }
            </section>
            <div class="kb-actions-inline">
                <button type="button" class="kb-btn kb-btn--ghost" @onclick="() => rewards.Add(new RewardForm())">Agregar recompensa</button>
                <button type="submit" class="kb-btn kb-btn--primary">@(busy ? "Guardando..." : "Guardar reglas y recompensas")</button>
            </div>
        </fieldset>
    </form>
    @if (visuals is not null)
    {
        <section class="kb-stamp-section">
            <h2>Apariencia de la tarjeta</h2>
            <p class="kb-muted">Las imágenes se aplican inmediatamente en todas las tarjetas. No necesitas guardar reglas y recompensas para aplicar estas acciones.</p>
            <StampImageUpload Label="Sello vacío" Preview="@visuals.EmptyPreview" Kind="StampImageKind.Empty" Disabled="@(busy || visualBusy)" Changed="ReloadVisualsAsync" BusyChanged="SetVisualBusy" />
            <StampImageUpload Label="Sello lleno" Preview="@visuals.FilledPreview" Kind="StampImageKind.Filled" Disabled="@(busy || visualBusy)" Changed="ReloadVisualsAsync" BusyChanged="SetVisualBusy" />
            @foreach (var reward in current?.Rewards ?? [])
            {
                if (reward.RewardIdentityId is Guid identity && visuals.RewardPreviews.TryGetValue(identity, out var preview))
                {
                    <h3>@reward.Name</h3>
                    <StampImageUpload @key="identity" Label="Imagen disponible" Preview="@preview" Kind="StampImageKind.Reward"
                        HelpText="Esta es la imagen que verá el cliente cuando desbloquee la recompensa."
                        RewardIdentityId="identity" Disabled="@(busy || visualBusy)" Changed="ReloadVisualsAsync" BusyChanged="SetVisualBusy" />
                    @if (visuals.UpcomingRewardPreviews.TryGetValue(identity, out var upcoming))
                    {
                        <StampImageUpload Label="Imagen antes de desbloquear (opcional)" Preview="@upcoming.Preview" Kind="StampImageKind.UpcomingReward"
                            HasCustomImage="@upcoming.IsCustom" HelpText="Opcional. Si no agregas una imagen, usaremos la imagen disponible en escala de grises hasta que el cliente desbloquee la recompensa."
                            RewardIdentityId="identity" Disabled="@(busy || visualBusy)" Changed="ReloadVisualsAsync" BusyChanged="SetVisualBusy" />
                    }
                }
            }
        </section>
    }
}

@code {
    private bool loading = true, busy, visualBusy, isStamps;
    private int maxStamps = 10, welcomeStamps;
    private StampReversalPolicy policy = StampReversalPolicy.None;
    private StampProgramDto? current;
    private StampVisualDto? visuals;
    private readonly List<RewardForm> rewards = [];
    private readonly List<string> errors = [];
    private string? error, success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CurrentUser.SetCircuitPrincipal((await Authentication.GetAuthenticationStateAsync()).User);
            isStamps = await Programs.GetCurrentAsync() == LoyaltyProgramType.Stamps;
            if (!isStamps) return;
            current = await Sender.Send(new GetActiveStampProgramQuery());
            await ReloadVisualsAsync();
            if (current is null) return;
            maxStamps = current.MaxStamps; welcomeStamps = current.WelcomeStamps; policy = current.ReversalPolicy;
            rewards.AddRange(current.Rewards.Select(r => new RewardForm { RewardIdentityId = r.RewardIdentityId, RequiredStamps = r.RequiredStamps, Name = r.Name, ShortName = r.ShortName ?? "", Description = r.Description }));
        }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (busy || visualBusy || !isStamps) return;
        success = error = null; errors.Clear();
        var command = new SetStampProgramCommand(maxStamps, welcomeStamps, policy,
            rewards.Select(r => new StampRewardInput(r.RequiredStamps, r.Name, r.Description, r.RewardIdentityId, r.ShortName)).ToList());
        var validation = await new SetStampProgramValidator().ValidateAsync(command);
        if (!validation.IsValid) { errors.AddRange(validation.Errors.Select(x => x.ErrorMessage).Distinct()); return; }
        busy = true;
        try
        {
            CurrentUser.SetCircuitPrincipal((await Authentication.GetAuthenticationStateAsync()).User);
            var result = await Sender.Send(command);
            if (result.IsFailure) { error = result.Error; return; }
            success = current?.Id == result.Value.Id ? "No hay cambios para guardar." : "Programa de sellos guardado.";
            current = result.Value;
            await ReloadVisualsAsync();
            rewards.Clear();
            rewards.AddRange(current.Rewards.Select(r => new RewardForm { RewardIdentityId = r.RewardIdentityId, RequiredStamps = r.RequiredStamps, Name = r.Name, ShortName = r.ShortName ?? "", Description = r.Description }));
        }
        finally { busy = false; }
    }

    private async Task ReloadVisualsAsync()
    {
        CurrentUser.SetCircuitPrincipal((await Authentication.GetAuthenticationStateAsync()).User);
        visuals = await Visuals.ReadAsync();
    }
    private void SetVisualBusy(bool value) => visualBusy = value;

    private sealed class RewardForm
    {
        public Guid? RewardIdentityId { get; set; }
        public int RequiredStamps { get; set; } = 1;
        public string Name { get; set; } = string.Empty;
        public string ShortName { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}

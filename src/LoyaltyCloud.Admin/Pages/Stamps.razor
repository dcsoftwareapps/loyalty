@page "/stamps"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.TenantAuthorizationPolicies.TenantAdmin)]
@rendermode InteractiveServer
@using LoyaltyCloud.Application.Stamps
@using LoyaltyCloud.Domain.Enums
@inject ISender Sender
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantProgramReadService Programs

<PageTitle>Sellos - LoyaltyCloud</PageTitle>

<header class="kb-page-header"><div><h1>Sellos</h1></div></header>
@if (loading) { <p>Cargando...</p> }
else if (!isStamps) { <p>Este programa no está disponible para tu negocio.</p> }
else
{
    @if (current is null) { <h2>Configura tu programa de sellos</h2> }
    else { <p class="kb-muted">Los cambios aplicarán a las nuevas tarjetas y ciclos. Las tarjetas actuales conservarán sus reglas.</p> }
    @if (error is not null) { <div class="kb-form-error" role="alert">@error</div> }
    @if (success is not null) { <div class="kb-form-success" role="status">@success</div> }
    @foreach (var message in errors) { <div class="kb-form-error" role="alert">@message</div> }
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <fieldset disabled="@busy" class="kb-stamp-form">
            <div class="kb-form-row">
                <label for="stamp-max">Sellos para completar tarjeta</label>
                <input id="stamp-max" type="number" min="2" max="12" step="1" @bind="maxStamps" />
            </div>
            <div class="kb-form-row">
                <label for="stamp-welcome">Sellos de bienvenida</label>
                <input id="stamp-welcome" type="number" min="0" max="@(maxStamps - 1)" step="1" @bind="welcomeStamps" />
                <small class="kb-muted">Se aplican solamente al primer ciclo del cliente.</small>
            </div>
            <div class="kb-form-row">
                <label for="stamp-reversal">Reversión de sellos</label>
                <select id="stamp-reversal" @bind="policy">
                    <option value="@StampReversalPolicy.None">No permitir</option>
                    <option value="@StampReversalPolicy.AdminOnly">Solo administradores</option>
                    <option value="@StampReversalPolicy.AdminAndCashier">Administradores y cajeros</option>
                </select>
            </div>
            <h2>Recompensas</h2>
            <p class="kb-muted">Agrega una recompensa para el último sello de la tarjeta.</p>
            @for (var i = 0; i < rewards.Count; i++)
            {
                var reward = rewards[i];
                var index = i;
                <div class="kb-stamp-reward" @key="reward">
                    <div class="kb-field"><label for="@($"stamp-threshold-{index}")">Sello</label><input id="@($"stamp-threshold-{index}")" type="number" min="1" max="@maxStamps" @bind="reward.RequiredStamps" /></div>
                    <div class="kb-field"><label for="@($"stamp-name-{index}")">Nombre</label><input id="@($"stamp-name-{index}")" maxlength="150" @bind="reward.Name" required /></div>
                    <div class="kb-field"><label for="@($"stamp-description-{index}")">Descripción (opcional)</label><textarea id="@($"stamp-description-{index}")" maxlength="1000" rows="2" @bind="reward.Description"></textarea></div>
                    <button type="button" class="kb-icon-button" title="Eliminar recompensa" aria-label="Eliminar recompensa" @onclick="() => rewards.Remove(reward)"><NavIcon Name="close" /></button>
                </div>
            }
            <div class="kb-actions-inline">
                <button type="button" class="kb-btn kb-btn--ghost" @onclick="() => rewards.Add(new RewardForm())">Agregar recompensa</button>
                <button type="submit" class="kb-btn kb-btn--primary">@(busy ? "Guardando..." : "Guardar cambios")</button>
            </div>
        </fieldset>
    </form>
}

@code {
    private bool loading = true, busy, isStamps;
    private int maxStamps = 10, welcomeStamps;
    private StampReversalPolicy policy = StampReversalPolicy.None;
    private StampProgramDto? current;
    private readonly List<RewardForm> rewards = [];
    private readonly List<string> errors = [];
    private string? error, success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isStamps = await Programs.GetCurrentAsync() == LoyaltyProgramType.Stamps;
            if (!isStamps) return;
            current = await Sender.Send(new GetActiveStampProgramQuery());
            if (current is null) return;
            maxStamps = current.MaxStamps; welcomeStamps = current.WelcomeStamps; policy = current.ReversalPolicy;
            rewards.AddRange(current.Rewards.Select(r => new RewardForm { RequiredStamps = r.RequiredStamps, Name = r.Name, Description = r.Description }));
        }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (busy || !isStamps) return;
        success = error = null; errors.Clear();
        var command = new SetStampProgramCommand(maxStamps, welcomeStamps, policy,
            rewards.Select(r => new StampRewardInput(r.RequiredStamps, r.Name, r.Description)).ToList());
        var validation = await new SetStampProgramValidator().ValidateAsync(command);
        if (!validation.IsValid) { errors.AddRange(validation.Errors.Select(x => x.ErrorMessage).Distinct()); return; }
        busy = true;
        try
        {
            var result = await Sender.Send(command);
            if (result.IsFailure) { error = result.Error; return; }
            success = current?.Id == result.Value.Id ? "No hay cambios para guardar." : "Programa de sellos guardado.";
            current = result.Value;
        }
        finally { busy = false; }
    }

    private sealed class RewardForm
    {
        public int RequiredStamps { get; set; } = 1;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}

@page "/reports/visit-frequency"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISender Sender
<PageTitle>Frecuencia de visita - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Reportes avanzados</span><h1>Frecuencia de visita</h1><p>Entiende cada cuánto regresan tus clientes y quiénes generan hábito.</p></div></header><ReportSubnav />
<section class="kb-card kb-reports-filters"><div><label for="frequencyPeriod">Periodo</label><select id="frequencyPeriod" @bind="period" @bind:after="LoadAsync"><option value="30">Últimos 30 días</option><option value="90">Últimos 90 días</option><option value="180">Últimos 6 meses</option><option value="365">Último año</option><option value="custom">Personalizado</option></select></div><div><label for="frequencyLimit">Detalle</label><select id="frequencyLimit" @bind="limit" @bind:after="LoadAsync"><option value="50">50 clientes</option><option value="100">100 clientes</option><option value="200">200 clientes</option></select></div>
@if(period=="custom"){<div><label for="frequencyStart">Fecha inicio</label><input id="frequencyStart" type="date" @bind="customStart" /></div><div><label for="frequencyEnd">Fecha fin</label><input id="frequencyEnd" type="date" @bind="customEnd" /></div><button class="kb-btn kb-btn--primary" @onclick="LoadAsync">Aplicar</button>}
</section>
@if (error is not null) { <div class="kb-form-error">@error</div> } @if (loading) { <div class="kb-loading-state"><span class="kb-spinner"></span><span>Calculando frecuencia…</span></div> } else if (report is not null) {
<section class="kb-kpi-grid"><article class="kb-kpi-card"><span>Promedio entre visitas</span><strong>@(report.AverageDaysBetweenVisits?.ToString("N1") ?? "—")</strong><small>días</small></article><article class="kb-kpi-card"><span>Clientes frecuentes</span><strong>@(report.FourToSixVisits + report.SevenPlusVisits).ToString("N0")</strong><small>4+ visitas en el periodo</small></article><article class="kb-kpi-card"><span>Clientes analizados</span><strong>@report.Customers.Count.ToString("N0")</strong><small>con actividad real</small></article></section>
<section class="kb-report-panel"><div class="kb-panel-heading"><div><span class="kb-eyebrow">Distribución</span><h2>Visitas por cliente</h2></div></div><ReportBarChart Labels="@BucketLabels" Values="@BucketValues" AriaLabel="Distribución de frecuencia de visita" /></section>
@if (report.Customers.Count == 0) { <div class="kb-empty-state"><h3>Sin visitas en este periodo</h3><p>La frecuencia aparecerá cuando existan movimientos o canjes.</p></div> } else { <div class="kb-table-shell"><div class="kb-table-responsive"><table class="kb-table"><thead><tr><th>Cliente</th><th>Nivel</th><th class="kb-cell-number">Visitas</th><th class="kb-cell-number">Promedio entre visitas</th><th>Última visita</th></tr></thead><tbody>@foreach (var item in report.Customers) { <tr><td><a href="@($"/customers/{item.CustomerId}")">@item.CustomerName</a></td><td>@item.Level</td><td class="kb-cell-number">@item.Visits</td><td class="kb-cell-number">@(item.AverageDaysBetweenVisits?.ToString("N1") ?? "—") días</td><td>@item.LastVisitUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr> }</tbody></table></div></div> }
}
@code { private VisitFrequencyReportDto? report; private bool loading; private string? error; private string period="90"; private int limit=100; private DateTime customStart=DateTime.UtcNow.Date.AddDays(-90); private DateTime customEnd=DateTime.UtcNow.Date; private IReadOnlyList<string> BucketLabels => new[] {"1 visita","2–3 visitas","4–6 visitas","7+ visitas"}; private IReadOnlyList<decimal> BucketValues => report is null ? Array.Empty<decimal>() : new decimal[]{report.OneVisit,report.TwoToThreeVisits,report.FourToSixVisits,report.SevenPlusVisits}; protected override Task OnInitializedAsync()=>LoadAsync(); private async Task LoadAsync(){loading=true;error=null;var today=DateTime.UtcNow.Date;var start=period=="custom"?DateTime.SpecifyKind(customStart.Date,DateTimeKind.Utc):today.AddDays(-int.Parse(period));var end=period=="custom"?DateTime.SpecifyKind(customEnd.Date.AddDays(1),DateTimeKind.Utc):today.AddDays(1);var result=await Sender.Send(new GetVisitFrequencyReportQuery(start,end,limit));if(result.IsSuccess)report=result.Value;else error=result.Error;loading=false;} }
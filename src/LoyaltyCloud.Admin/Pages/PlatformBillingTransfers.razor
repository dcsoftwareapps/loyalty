@page "/platform/billing-transfers"
@layout PlatformLayout
@attribute [Authorize(Roles = LoyaltyCloud.Admin.Auth.SuperAdminAuthDefaults.Role)]
@rendermode InteractiveServer
@using LoyaltyCloud.Application.Billing
@inject IBillingService Billing
@inject AdminDateTimeFormatter Dates

<PageTitle>Transferencias pendientes · LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Cobros</span><h1>Transferencias pendientes</h1><p>Revisa y resuelve los pagos por transferencia que requieren validación.</p></div></header>

@if (error is not null)
{
    <div class="kb-form-error" role="alert">@error</div>
}

@if (orders.Count == 0)
{
    <section class="kb-card kb-empty-state">
        <span class="kb-empty-icon"><NavIcon Name="history" /></span>
        <h3>No hay transferencias pendientes</h3>
        <p>Las nuevas solicitudes aparecerán aquí cuando requieran revisión.</p>
    </section>
}
else
{
    <section class="kb-card kb-table-shell">
        <div class="kb-table-responsive">
            <table class="kb-table">
                <thead><tr><th>Fecha</th><th>Tenant</th><th>Referencia</th><th class="kb-cell-number">Total</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var order in orders)
                {
                    <tr>
                        <td>@Dates.DateTime(order.CreatedAt)</td>
                        <td><code>@order.TenantId</code></td>
                        <td>@order.BankReference</td>
                        <td class="kb-cell-number">@order.Total.ToString("C") @order.Currency</td>
                        <td><div class="kb-row-actions"><button class="kb-btn kb-btn--primary" @onclick="() => Approve(order.Id)">Aprobar</button><button class="kb-btn kb-btn--ghost" @onclick="() => Reject(order.Id)">Rechazar</button></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private IReadOnlyList<BillingOrderDto> orders = [];
    private string? error;

    protected override async Task OnInitializedAsync() => orders = await Billing.GetAwaitingTransfersAsync();

    private async Task Approve(Guid id)
    {
        try { await Billing.ApproveTransferAsync(id, "SuperAdmin"); orders = await Billing.GetAwaitingTransfersAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Reject(Guid id)
    {
        try { await Billing.RejectTransferAsync(id, "SuperAdmin"); orders = await Billing.GetAwaitingTransfersAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }
}

@page "/giftcards/cards/{Id:guid}"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.GiftCardsAuthorization.Policy)]
@rendermode InteractiveServer
@using LoyaltyCloud.Domain.Enums
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject LoyaltyCloud.Application.GiftCards.IGiftCardDeliveryService Delivery
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantBrandingReadService Branding
@inject AdminDateTimeFormatter Dates
<PageTitle>Detalle de tarjeta de regalo - LoyaltyCloud</PageTitle>
@if(detail is null){<div class="kb-panel kb-empty-state"><p>Cargando tarjeta de regalo…</p></div>}else{
<header class="kb-page-header"><div><span class="kb-eyebrow">Tarjetas de regalo</span><h1>@detail.Card.Code</h1><div class="kb-gift-detail-meta"><span class="kb-badge @StatusClass">@StatusLabel</span><span>@detail.Card.RecipientName</span></div></div><div class="kb-gift-detail-balance"><small>Saldo disponible</small><strong>@Money(detail.Card.CurrentBalance)</strong><span>@detail.Card.Currency</span></div></header>@if(message is not null){<div class="@(isError?"kb-form-error":"kb-form-success")" role="status">@message</div>}
<div class="kb-gift-summary-grid"><div><span>Destinatario</span><strong>@detail.Card.RecipientName</strong></div><div><span>Emitida</span><strong>@Dates.DateNumeric(detail.Card.IssuedAtUtc)</strong></div><div><span>Vigencia</span><strong>@Dates.DateNumeric(detail.Card.ExpiresAtUtc, "Sin expiración")</strong></div><div><span>Estado</span><strong>@StatusLabel</strong></div></div>
<section class="kb-panel"><div class="kb-section-heading"><div><h2>Entrega de tarjeta de regalo</h2><p>El enlace seguro y su QR se generan al emitir la tarjeta y nunca se almacenan en texto plano.</p></div></div><div class="kb-empty-state"><p>Para reenviar por email se genera un nuevo enlace seguro y el anterior deja de funcionar.</p>@if(!string.IsNullOrWhiteSpace(detail.Card.RecipientEmail)){<span>Destinatario: @detail.Card.RecipientEmail</span>}@if(CanResendEmail){<button class="kb-btn kb-btn--ghost" disabled="@deliveryBusy" @onclick="ResendEmailAsync">@(deliveryBusy?"Enviando…":"Reenviar por email")</button>}</div></section>
@if(detail.Card.Status==GiftCardStatus.Active){<section class="kb-panel"><div class="kb-section-heading"><div><h2>Redimir saldo</h2><p>Registra un canje contra el saldo disponible.</p></div></div><div class="kb-form-grid"><label class="kb-field"><span>Monto a redimir</span><input type="number" min="0.01" step="0.01" @bind="redeemAmount" onfocus="loyaltyGiftCardWallet.selectZero(this)" /></label><label class="kb-field"><span>Referencia <small>(opcional)</small></span><input maxlength="150" @bind="reference" /></label></div>@if(redeemError is not null){<p class="kb-form-error">@redeemError</p>}@if(ValidPreview){<div class="kb-gift-balance-preview"><span>Saldo actual<strong>@Money(detail.Card.CurrentBalance)</strong></span><span>Canje<strong>-@Money(redeemAmount)</strong></span><span>Saldo restante<strong>@Money(detail.Card.CurrentBalance-redeemAmount)</strong></span></div>}<button class="kb-btn kb-btn--primary" disabled="@busy" @onclick="RequestRedeem">@(busy?"Procesando…":$"Redimir {Money(redeemAmount)}")</button></section>}
<section class="kb-panel"><div class="kb-section-heading"><div><h2>Historial auditable</h2><p>Cada movimiento conserva el saldo anterior y posterior.</p></div></div><div class="kb-table-shell kb-table-responsive"><table class="kb-table"><thead><tr><th>Fecha</th><th>Movimiento</th><th>Monto</th><th>Saldo anterior</th><th>Saldo posterior</th><th>Referencia</th></tr></thead><tbody>@foreach(var tx in detail.Transactions){<tr><td data-label="Fecha">@Dates.DateTime(tx.CreatedAtUtc)</td><td data-label="Movimiento">@TransactionLabel(tx.Type)</td><td data-label="Monto">@Money(tx.Amount)</td><td data-label="Saldo anterior">@Money(tx.BalanceBefore)</td><td data-label="Saldo posterior">@Money(tx.BalanceAfter)</td><td data-label="Referencia">@(tx.Reference??"—")</td></tr>}</tbody></table></div></section>
@if(detail.Card.Status==GiftCardStatus.Active){<section class="kb-panel kb-danger-zone"><div><h2>Zona de riesgo</h2><p>Cancelar impide futuros canjes y conserva todo el historial.</p></div><button class="kb-btn kb-btn--danger" disabled="@busy" @onclick="()=>showCancel=true">Cancelar tarjeta de regalo</button></section>}
@if(showRedeem){<div class="kb-modal-overlay" role="presentation"><section class="kb-modal" role="dialog" aria-modal="true" aria-labelledby="redeem-title"><h2 id="redeem-title">Confirmar canje</h2><p>Vas a redimir <strong>@Money(redeemAmount) @detail.Card.Currency</strong>.</p><dl><div><dt>Saldo actual</dt><dd>@Money(detail.Card.CurrentBalance)</dd></div><div><dt>Saldo después</dt><dd>@Money(detail.Card.CurrentBalance-redeemAmount)</dd></div></dl><div class="kb-actions"><button class="kb-btn kb-btn--ghost" disabled="@busy" @onclick="()=>showRedeem=false">Volver</button><button class="kb-btn kb-btn--primary" disabled="@busy" @onclick="ConfirmRedeem">@(busy?"Procesando…":"Confirmar canje")</button></div></section></div>}
@if(showCancel){<div class="kb-modal-overlay" role="presentation"><section class="kb-modal" role="dialog" aria-modal="true" aria-labelledby="cancel-title"><h2 id="cancel-title">Cancelar tarjeta de regalo</h2><p>¿Estás seguro de que deseas cancelar esta tarjeta de regalo?</p><dl><div><dt>Tarjeta</dt><dd>@detail.Card.Code</dd></div><div><dt>Saldo disponible</dt><dd>@Money(detail.Card.CurrentBalance) @detail.Card.Currency</dd></div><div><dt>Destinatario</dt><dd>@detail.Card.RecipientName</dd></div></dl><p>Esta acción impedirá que vuelva a utilizarse. El historial se conservará.</p><div class="kb-actions"><button class="kb-btn kb-btn--ghost" disabled="@busy" @onclick="()=>showCancel=false">Volver</button><button class="kb-btn kb-btn--danger" disabled="@busy" @onclick="ConfirmCancel">@(busy?"Cancelando…":"Sí, cancelar tarjeta")</button></div></section></div>}}
@code{
 [Parameter]public Guid Id{get;set;} LoyaltyCloud.Application.GiftCards.GiftCardDetailDto? detail;decimal redeemAmount;string? reference,message,redeemError;bool busy,deliveryBusy,isError,showRedeem,showCancel;bool ValidPreview=>detail is not null&&redeemAmount>0&&redeemAmount<=detail.Card.CurrentBalance&&decimal.Round(redeemAmount,2)==redeemAmount;bool CanResendEmail=>detail?.Card.Status==GiftCardStatus.Active&&!string.IsNullOrWhiteSpace(detail.Card.RecipientEmail);string Money(decimal value)=>value.ToString("N2");string StatusLabel=>detail?.Card.Status switch{GiftCardStatus.Active=>"Activa",GiftCardStatus.FullyRedeemed=>"Canjeada",GiftCardStatus.Expired=>"Expirada",_=>"Cancelada"};string StatusClass=>detail?.Card.Status==GiftCardStatus.Active?"kb-badge--success":detail?.Card.Status==GiftCardStatus.FullyRedeemed?"kb-badge--info":detail?.Card.Status==GiftCardStatus.Cancelled?"kb-badge--danger":"kb-badge--muted";
 void RequestRedeem(){redeemError=null;if(redeemAmount<=0){redeemError="Ingresa un monto mayor a $0.";return;}if(decimal.Round(redeemAmount,2)!=redeemAmount){redeemError="Usa máximo dos decimales.";return;}if(detail is null||redeemAmount>detail.Card.CurrentBalance){redeemError="El monto no puede ser mayor al saldo disponible.";return;}showRedeem=true;}
 async Task ConfirmRedeem(){if(detail is null||busy)return;try{busy=true;message=null;var result=await Service.RedeemAsync(detail.Card.Code,redeemAmount,Guid.NewGuid().ToString("N"),reference,null);if(!result.Success){ShowError(result.Error);return;}detail=result.Detail;showRedeem=false;message="Canje realizado correctamente.";isError=false;redeemAmount=0;reference=null;}catch(Exception){ShowError("No fue posible completar el canje. Intenta nuevamente.");}finally{busy=false;}}
 async Task ConfirmCancel(){if(busy)return;try{busy=true;message=null;var result=await Service.CancelAsync(Id,Guid.NewGuid().ToString("N"),"Cancelada por administrador");if(!result.Success){ShowError(result.Error);return;}detail=result.Detail;showCancel=false;message="Tarjeta de regalo cancelada correctamente.";isError=false;}catch(Exception){ShowError("No fue posible cancelar la tarjeta de regalo. Intenta nuevamente.");}finally{busy=false;}}
 async Task ResendEmailAsync(){if(!CanResendEmail||deliveryBusy)return;try{deliveryBusy=true;message=null;var branding=await Branding.GetCurrentAsync();var issued=await Service.RotateClaimTokenAsync(Id);var delivery=await Delivery.SendEmailAsync(issued,issued.Card.RecipientEmail!,branding.DisplayName);message=delivery.Message;isError=!delivery.Sent;detail=await Service.GetAsync(Id);}catch(Exception){ShowError("No fue posible reenviar el email. Intenta nuevamente.");}finally{deliveryBusy=false;}}
 void ShowError(string? value){message=string.IsNullOrWhiteSpace(value)?"No fue posible completar la operación.":value;isError=true;showRedeem=false;showCancel=false;}
 static string TransactionLabel(GiftCardTransactionType type)=>type switch{GiftCardTransactionType.Issued=>"Emitida",GiftCardTransactionType.Redeemed=>"Canje",GiftCardTransactionType.AdjustmentCredit or GiftCardTransactionType.AdjustmentDebit=>"Ajuste de saldo",GiftCardTransactionType.Cancelled=>"Cancelada",GiftCardTransactionType.Expired=>"Expirada",_=>"Movimiento"};
 protected override async Task OnParametersSetAsync(){detail=await Service.GetAsync(Id);message=detail is null?"No encontramos esta tarjeta de regalo.":null;isError=detail is null;}
}

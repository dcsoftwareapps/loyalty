@page "/giftcards/cards/{Id:guid}"
@attribute [Authorize(Policy = LoyaltyCloud.Admin.Auth.GiftCardsAuthorization.Policy)]
@rendermode InteractiveServer
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject LoyaltyCloud.Application.GiftCards.IGiftCardWalletService Wallet
@inject LoyaltyCloud.Application.GiftCards.IGiftCardAppleWalletService AppleWallet
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AdminDateTimeFormatter Dates
<PageTitle>Detalle Gift Card - LoyaltyCloud</PageTitle>
@if(detail is null){<p>Cargando…</p>}else{<header class="kb-page-header"><div><span class="kb-eyebrow">Gift Cards</span><h1>@detail.Card.Code</h1><p>@detail.Card.RecipientName · @detail.Card.Status</p></div><strong>@detail.Card.CurrentBalance.ToString("C2") @detail.Card.Currency</strong></header><section class="kb-card"><div class="kb-actions"><button class="kb-button" @onclick="AddApple">Agregar a Apple Wallet</button><button class="kb-button" @onclick="AddGoogle">Agregar a Google Wallet</button></div>@if(walletError is not null){<div class="alert alert-danger">@walletError</div>}<h2>Operaciones administrativas</h2>@if(detail.Card.Status == LoyaltyCloud.Domain.Enums.GiftCardStatus.Active){<div class="kb-form-grid"><label>Ajuste (+ crédito / - débito)<input type="number" step="0.01" @bind="adjustment" /></label><label>Motivo requerido<input @bind="notes" /></label></div><div class="kb-actions"><button class="kb-button" @onclick="Adjust">Aplicar ajuste</button><label><input type="checkbox" @bind="confirmCancel" /> Confirmo cancelar esta Gift Card</label><button class="kb-button" disabled="@(!confirmCancel)" @onclick="Cancel">Cancelar tarjeta</button></div>}@if(operationMessage is not null){<div class="alert alert-info">@operationMessage</div>}<h2>Historial auditable</h2><div class="kb-table-wrap"><table class="kb-table"><thead><tr><th>Fecha</th><th>Movimiento</th><th>Monto</th><th>Antes</th><th>Después</th><th>Referencia</th></tr></thead><tbody>@foreach(var tx in detail.Transactions){<tr><td>@Dates.DateTime(tx.CreatedAtUtc)</td><td>@tx.Type</td><td>@tx.Amount.ToString("C2")</td><td>@tx.BalanceBefore.ToString("C2")</td><td>@tx.BalanceAfter.ToString("C2")</td><td>@tx.Reference</td></tr>}</tbody></table></div></section>}
@code { [Parameter] public Guid Id{get;set;} LoyaltyCloud.Application.GiftCards.GiftCardDetailDto? detail; string? walletError, notes, operationMessage; decimal adjustment; bool confirmCancel; async Task Adjust(){if(string.IsNullOrWhiteSpace(notes)){operationMessage="El motivo es requerido.";return;}var r=await Service.AdjustAsync(Id,adjustment,Guid.NewGuid().ToString("N"),null,notes);operationMessage=r.Error??"Ajuste aplicado.";detail=r.Detail;} async Task Cancel(){if(!confirmCancel)return;var r=await Service.CancelAsync(Id,Guid.NewGuid().ToString("N"),notes);operationMessage=r.Error??"Gift Card cancelada.";detail=r.Detail;} async Task AddApple(){try{var pass=await AppleWallet.CreateOrUpdatePassAsync(Id);await JS.InvokeVoidAsync("giftCardWallet.downloadPass",pass.Bytes,$"giftcard-{detail?.Card.Code ?? Id.ToString("N")}.pkpass");}catch(Exception ex){walletError=ex.Message;}} async Task AddGoogle(){try{var link=await Wallet.GetGoogleSaveLinkAsync(Id);Navigation.NavigateTo(link.Url,true);}catch(Exception ex){walletError=ex.Message;}} protected override async Task OnParametersSetAsync()=>detail=await Service.GetAsync(Id); }

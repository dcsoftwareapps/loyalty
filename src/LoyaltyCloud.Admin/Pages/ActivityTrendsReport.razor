@page "/reports/activity-trends"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISender Sender
<PageTitle>Actividad y tendencias - LoyaltyCloud</PageTitle>
<header class="kb-page-header"><div><span class="kb-eyebrow">Reportes avanzados</span><h1>Actividad y tendencias</h1><p>Observa el crecimiento del programa y detecta cambios de comportamiento.</p></div></header><ReportSubnav />
<section class="kb-card kb-reports-filters"><div><label for="trendPeriod">Periodo</label><select id="trendPeriod" @bind="period" @bind:after="LoadAsync"><option value="6">Últimos 6 meses</option><option value="12">Últimos 12 meses</option><option value="year">Año actual</option><option value="custom">Personalizado</option></select></div><div><label for="trendMetric">Métrica</label><select id="trendMetric" @bind="metric"><option value="active">Clientes activos</option><option value="issued">Puntos emitidos</option><option value="redeemed">Puntos canjeados</option><option value="redemptions">Canjes</option><option value="purchases">Compras registradas</option></select></div>@if(period=="custom"){<div><label for="trendStart">Fecha inicio</label><input id="trendStart" type="date" @bind="customStart" /></div><div><label for="trendEnd">Fecha fin</label><input id="trendEnd" type="date" @bind="customEnd" /></div><button class="kb-btn kb-btn--primary" @onclick="LoadAsync">Aplicar</button>}
</section>
@if(error is not null){<div class="kb-form-error">@error</div>} @if(loading){<div class="kb-loading-state"><span class="kb-spinner"></span><span>Construyendo tendencias…</span></div>} else if(report is not null){var latest=report.Periods.LastOrDefault();<section class="kb-kpi-grid"><article class="kb-kpi-card"><span>Clientes activos</span><strong>@(latest?.ActiveCustomers.ToString("N0")??"0")</strong><small>último mes</small></article><article class="kb-kpi-card"><span>Puntos emitidos</span><strong>@(latest?.PointsIssued.ToString("N0")??"0")</strong><small>último mes</small></article><article class="kb-kpi-card"><span>Canjes</span><strong>@(latest?.Redemptions.ToString("N0")??"0")</strong><small>último mes</small></article></section><section class="kb-report-panel"><div class="kb-panel-heading"><div><span class="kb-eyebrow">Tendencia mensual</span><h2>@MetricLabel</h2></div></div><ReportLineChart Labels="@report.Periods.Select(x=>x.Label).ToList()" Values="@ChartValues" AriaLabel="@($"Tendencia mensual de {MetricLabel}")" /></section><div class="kb-table-shell"><div class="kb-table-responsive"><table class="kb-table"><thead><tr><th>Mes</th><th class="kb-cell-number">Activos</th><th class="kb-cell-number">Puntos emitidos</th><th class="kb-cell-number">Puntos canjeados</th><th class="kb-cell-number">Canjes</th><th class="kb-cell-number">Compras</th><th class="kb-cell-number">Monto</th></tr></thead><tbody>@foreach(var item in report.Periods){<tr><td>@item.Label</td><td class="kb-cell-number">@item.ActiveCustomers.ToString("N0")</td><td class="kb-cell-number">@item.PointsIssued.ToString("N0")</td><td class="kb-cell-number">@item.PointsRedeemed.ToString("N0")</td><td class="kb-cell-number">@item.Redemptions.ToString("N0")</td><td class="kb-cell-number">@item.Purchases.ToString("N0")</td><td class="kb-cell-number">@item.PurchaseAmount.ToString("C0")</td></tr>}</tbody></table></div></div>}
@code {private ActivityTrendsReportDto? report;private bool loading;private string? error;private string period="12";private DateTime customStart=DateTime.UtcNow.Date.AddMonths(-12);private DateTime customEnd=DateTime.UtcNow.Date;private string metric="active";private string MetricLabel=>metric switch{"issued"=>"Puntos emitidos","redeemed"=>"Puntos canjeados","redemptions"=>"Canjes","purchases"=>"Compras registradas",_=>"Clientes activos"};private IReadOnlyList<decimal> ChartValues=>report is null?Array.Empty<decimal>():report.Periods.Select(x=>metric switch{"issued"=>(decimal)x.PointsIssued,"redeemed"=>x.PointsRedeemed,"redemptions"=>x.Redemptions,"purchases"=>x.Purchases,_=>x.ActiveCustomers}).ToList();protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;error=null;var today=DateTime.UtcNow.Date;var end=period=="custom"?DateTime.SpecifyKind(customEnd.Date.AddDays(1),DateTimeKind.Utc):today.AddDays(1);var start=period switch{"year"=>new DateTime(today.Year,1,1,0,0,0,DateTimeKind.Utc),"custom"=>DateTime.SpecifyKind(customStart.Date,DateTimeKind.Utc),_=>today.AddMonths(-int.Parse(period))};var result=await Sender.Send(new GetActivityTrendsReportQuery(start,end));if(result.IsSuccess)report=result.Value;else error=result.Error;loading=false;}}
@page "/platform/billing-settings"
@layout PlatformLayout
@attribute [Authorize(Roles = LoyaltyCloud.Admin.Auth.SuperAdminAuthDefaults.Role)]
@rendermode InteractiveServer
@using LoyaltyCloud.Application.Billing
@inject IBillingService Billing
@inject ILogger<PlatformBillingSettings> Logger

<PageTitle>Configuración de Billing - LoyaltyCloud</PageTitle>

<header class="kb-page-header"><div><span class="kb-eyebrow">Plataforma</span><h1>Configuración de cobros</h1><p>Administra planes, recurrencia, Stripe y notificaciones por correo.</p></div></header>

@if (toastMessage is not null)
{
    <div class="kb-toast @(toastIsError ? "kb-toast--error" : "kb-toast--success")"
         role="@(toastIsError ? "alert" : "status")" aria-live="polite">
        @toastMessage
    </div>
}

@if (settings is null)
{
    <p>Cargando…</p>
}
else
{
    <section class="kb-card">
        <h2>Impuestos y suscripción</h2>
        <div class="kb-form-row">
            <label>Moneda</label><input @bind="currency" maxlength="3" disabled="@busy" />
            <label>IVA %</label><input type="number" step="0.01" @bind="taxRate" disabled="@busy" />
            <label><input type="checkbox" @bind="pricesIncludeTax" disabled="@busy" /> Precios incluyen IVA</label>
            <label>Días de gracia</label><input type="number" @bind="graceDays" disabled="@busy" />
        </div>
    </section>

    <section class="kb-card" style="margin-top:20px">
        <h2>Métodos de pago</h2>
        <label><input type="checkbox" @bind="card" disabled="@busy" /> Tarjeta / Stripe</label><br />
        <label><input type="checkbox" @bind="bank" disabled="@busy" /> Transferencia</label><br />
        <label><input type="checkbox" @bind="receipt" disabled="@busy" /> Requerir comprobante</label>
    </section>

    <section class="kb-card" style="margin-top:20px">
        <h2>Transferencias y soporte</h2>
        <div class="kb-form-row">
            <label>Banco</label><input @bind="bankName" disabled="@busy" />
            <label>Beneficiario</label><input @bind="beneficiary" disabled="@busy" />
            <label>CLABE</label><input @bind="clabe" disabled="@busy" />
            <label>Instrucciones</label><textarea @bind="instructions" disabled="@busy"></textarea>
            <label>Correo de soporte</label><input type="email" @bind="support" disabled="@busy" />
        </div>
    </section>

    <section class="kb-card" style="margin-top:20px">
        <h2>Notificaciones por email</h2>
        <p>Estado: <strong>@(emailEnabled ? "Habilitadas" : "Deshabilitadas")</strong></p>
        @if (!emailEnabled)
        {
            <p class="kb-muted">Las notificaciones por email están desactivadas. Billing y las renovaciones continuarán funcionando normalmente.</p>
        }
        <div class="kb-form-row">
            <label><input type="checkbox" @bind="emailEnabled" disabled="@busy" /> Habilitar notificaciones por email</label>
            <label>Proveedor</label>
            <select @bind="emailProvider" disabled="@busy">
                <option value="Cloudflare">Cloudflare</option>
            </select>
            <label>Nombre del remitente</label><input @bind="emailFromName" maxlength="100" disabled="@busy" />
            <label>Correo remitente</label><input type="email" @bind="emailFromAddress" maxlength="320" disabled="@busy" />
            <label>URL pública de LoyaltyCloud</label><input type="url" @bind="emailApplicationBaseUrl" maxlength="500" disabled="@busy" />
            <p>Credenciales: <strong>@(emailCredentialsConfigured ? "Configuradas" : "No configuradas")</strong></p>
            <p>Configuración: <strong>@(emailConfigurationComplete ? "Configurada" : "Incompleta")</strong></p>
            <button type="button" class="kb-btn kb-btn--ghost" @onclick="SaveEmailSettings" disabled="@busy">
                @(busy ? "Guardando..." : "Guardar configuración")
            </button>
        </div>
    </section>
    <section class="kb-card" style="margin-top:20px">
        <h2>Plan y precios</h2>
        <div class="kb-form-row">
            <label>Código</label><input @bind="planCode" disabled="@busy" />
            <label>Nombre</label><input @bind="planName" disabled="@busy" />
            <label>1 mes</label><input type="number" step="0.01" @bind="p1" disabled="@busy" />
            <label>3 meses</label><input type="number" step="0.01" @bind="p3" disabled="@busy" />
            <label>6 meses</label><input type="number" step="0.01" @bind="p6" disabled="@busy" />
            <label>12 meses</label><input type="number" step="0.01" @bind="p12" disabled="@busy" />
            <label>Stripe Price ID - 1 mes</label><input @bind="stripeP1" maxlength="200" disabled="@busy" />
            <label>Stripe Price ID - 3 meses</label><input @bind="stripeP3" maxlength="200" disabled="@busy" />
            <label>Stripe Price ID - 6 meses</label><input @bind="stripeP6" maxlength="200" disabled="@busy" />
            <label>Stripe Price ID - 12 meses</label><input @bind="stripeP12" maxlength="200" disabled="@busy" />
            <label><input type="checkbox" @bind="planActive" disabled="@busy" /> Plan activo</label>
            <button class="kb-btn kb-btn--ghost" @onclick="SavePlan" disabled="@busy">
                @(busy ? "Guardando..." : "Guardar plan")
            </button>
        </div>
        <p class="kb-muted">No se permite cobrar mientras el plan esté inactivo o tenga precio cero.</p>
    </section>

    <button class="kb-btn kb-btn--primary" style="margin-top:20px" @onclick="Save" disabled="@busy">
        @(busy ? "Guardando..." : "Guardar configuración")
    </button>
}

@code {
    private BillingSettingsDto? settings;
    private BillingEmailSettingsDto? emailSettings;
    private IReadOnlyList<SubscriptionPlanDto> plans = [];
    private Guid planId;
    private string planCode = "standard";
    private string planName = "Standard";
    private string currency = "MXN";
    private decimal p1, p3, p6, p12, taxRate = 16;
    private bool planActive, pricesIncludeTax;
    private int graceDays = 7;
    private bool card, bank, receipt, busy;
    private string? bankName, beneficiary, clabe, instructions, support;
    private string? stripeP1, stripeP3, stripeP6, stripeP12;
    private bool emailEnabled, emailCredentialsConfigured, emailConfigurationComplete;
    private string emailProvider = "Cloudflare", emailFromName = "LoyaltyCloud";
    private string? emailFromAddress, emailApplicationBaseUrl;
    private string? toastMessage;
    private bool toastIsError;
    private int toastVersion;

    protected override async Task OnInitializedAsync()
    {
        settings = await Billing.GetSettingsAsync();
        emailSettings = await Billing.GetEmailSettingsAsync();
        ApplyEmailSettings(emailSettings);
        plans = await Billing.GetPlansAsync();
        var plan = plans.FirstOrDefault();
        if (plan is not null)
            ApplyPlan(plan);

        currency = settings.Currency;
        taxRate = settings.TaxRate;
        pricesIncludeTax = settings.PricesIncludeTax;
        graceDays = settings.GracePeriodDays;
        card = settings.CardPaymentsEnabled;
        bank = settings.BankTransferEnabled;
        receipt = settings.RequireTransferReceipt;
        bankName = settings.BankName;
        beneficiary = settings.BeneficiaryName;
        clabe = settings.Clabe;
        instructions = settings.BankTransferInstructions;
        support = settings.SupportEmail;
    }

    private async Task Save()
    {
        if (busy)
            return;

        try
        {
            busy = true;
            await Billing.SaveSettingsAsync(new(
                currency, taxRate, pricesIncludeTax, graceDays, card, bank, receipt,
                false, false, bankName, beneficiary, clabe, instructions, support));
            ShowToast("Configuración guardada correctamente.", isError: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save billing settings.");
            ShowToast("No fue posible guardar la configuración.", isError: true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveEmailSettings()
    {
        if (busy) return;
        try
        {
            busy = true;
            await Billing.SaveEmailSettingsAsync(new(
                emailEnabled, emailProvider, EmptyToNull(emailFromAddress), emailFromName,
                EmptyToNull(emailApplicationBaseUrl), emailCredentialsConfigured, false));
            emailSettings = await Billing.GetEmailSettingsAsync();
            ApplyEmailSettings(emailSettings);
            ShowToast("Configuración de email guardada correctamente.", isError: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save billing email settings.");
            ShowToast("No fue posible guardar la configuración de email.", isError: true);
        }
        finally { busy = false; }
    }

    private void ApplyEmailSettings(BillingEmailSettingsDto value)
    {
        emailEnabled = value.Enabled;
        emailProvider = value.Provider;
        emailFromAddress = value.FromAddress;
        emailFromName = value.FromName;
        emailApplicationBaseUrl = value.ApplicationBaseUrl;
        emailCredentialsConfigured = value.CredentialsConfigured;
        emailConfigurationComplete = value.IsComplete;
    }
    private async Task SavePlan()
    {
        if (busy)
            return;

        try
        {
            busy = true;
            var requestedCode = planCode.Trim().ToLowerInvariant();
            var affected = await Billing.SavePlanAsync(new(planId, requestedCode, planName, currency, p1, p3, p6, p12, planActive, EmptyToNull(stripeP1), EmptyToNull(stripeP3), EmptyToNull(stripeP6), EmptyToNull(stripeP12)));
            plans = await Billing.GetPlansAsync();
            var persisted = plans.Single(x => x.Code == requestedCode);
            ApplyPlan(persisted);
            Logger.LogInformation("Billing plan {PlanCode} saved; affected rows: {AffectedRows}.", persisted.Code, affected);
            ShowToast("Plan guardado correctamente.", isError: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save billing plan {PlanCode}.", planCode);
            ShowToast("No fue posible guardar el plan.", isError: true);
        }
        finally
        {
            busy = false;
        }
    }

    private void ApplyPlan(SubscriptionPlanDto plan)
    {
        planId = plan.Id;
        planCode = plan.Code;
        planName = plan.Name;
        currency = plan.Currency;
        p1 = plan.OneMonthPrice;
        p3 = plan.ThreeMonthPrice;
        p6 = plan.SixMonthPrice;
        p12 = plan.TwelveMonthPrice;
        planActive = plan.IsActive;
        stripeP1 = plan.StripeOneMonthPriceId;
        stripeP3 = plan.StripeThreeMonthPriceId;
        stripeP6 = plan.StripeSixMonthPriceId;
        stripeP12 = plan.StripeTwelveMonthPriceId;
    }

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void ShowToast(string message, bool isError)
    {
        toastMessage = message;
        toastIsError = isError;
        var version = ++toastVersion;
        _ = DismissToastAsync(version);
    }

    private async Task DismissToastAsync(int version)
    {
        await Task.Delay(TimeSpan.FromSeconds(4));
        if (version != toastVersion)
            return;

        toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }
}

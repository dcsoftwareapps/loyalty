@page "/platform/billing-settings"
@layout PlatformLayout
@attribute [Authorize(Roles = LoyaltyCloud.Admin.Auth.SuperAdminAuthDefaults.Role)]
@rendermode InteractiveServer
@using LoyaltyCloud.Application.Billing
@inject IBillingService Billing
<h1>Billing Settings</h1>@if(message is not null){<div class="kb-form-success">@message</div>}@if(settings is null){<p>Cargando…</p>}else{
<section class="kb-card"><h2>Impuestos y suscripción</h2><div class="kb-form-row"><label>Moneda</label><input @bind="currency" maxlength="3"/><label>IVA %</label><input type="number" step="0.01" @bind="taxRate"/><label><input type="checkbox" @bind="pricesIncludeTax"/> Precios incluyen IVA</label><label>Días de gracia</label><input type="number" @bind="graceDays"/></div></section>
<section class="kb-card" style="margin-top:20px"><h2>Métodos de pago</h2><label><input type="checkbox" @bind="card"/> Tarjeta / Stripe</label><br/><label><input type="checkbox" @bind="bank"/> Transferencia</label><br/><label><input type="checkbox" @bind="receipt"/> Requerir comprobante</label></section>
<section class="kb-card" style="margin-top:20px"><h2>Transferencias y soporte</h2><div class="kb-form-row"><label>Banco</label><input @bind="bankName"/><label>Beneficiario</label><input @bind="beneficiary"/><label>CLABE</label><input @bind="clabe"/><label>Instrucciones</label><textarea @bind="instructions"></textarea><label>Correo de soporte</label><input type="email" @bind="support"/></div></section>
<section class="kb-card" style="margin-top:20px"><h2>Plan y precios</h2><div class="kb-form-row"><label>Código</label><input @bind="planCode"/><label>Nombre</label><input @bind="planName"/><label>1 mes</label><input type="number" step="0.01" @bind="p1"/><label>3 meses</label><input type="number" step="0.01" @bind="p3"/><label>6 meses</label><input type="number" step="0.01" @bind="p6"/><label>12 meses</label><input type="number" step="0.01" @bind="p12"/><label><input type="checkbox" @bind="planActive"/> Plan activo</label><button class="kb-btn kb-btn--ghost" @onclick="SavePlan">Guardar plan</button></div><p class="kb-muted">No se permite cobrar mientras el plan esté inactivo o tenga precio cero.</p></section>
<button class="kb-btn kb-btn--primary" style="margin-top:20px" @onclick="Save">Guardar configuración</button>}
@code{BillingSettingsDto? settings;IReadOnlyList<SubscriptionPlanDto> plans=[];Guid planId;string planCode="standard",planName="Standard",currency="MXN";decimal p1,p3,p6,p12,taxRate=16;bool planActive,pricesIncludeTax;int graceDays=7;bool card,bank,receipt;string? bankName,beneficiary,clabe,instructions,support,message;protected override async Task OnInitializedAsync(){settings=await Billing.GetSettingsAsync();plans=await Billing.GetPlansAsync();var p=plans.FirstOrDefault();if(p is not null){planId=p.Id;planCode=p.Code;planName=p.Name;p1=p.OneMonthPrice;p3=p.ThreeMonthPrice;p6=p.SixMonthPrice;p12=p.TwelveMonthPrice;planActive=p.IsActive;}currency=settings.Currency;taxRate=settings.TaxRate;pricesIncludeTax=settings.PricesIncludeTax;graceDays=settings.GracePeriodDays;card=settings.CardPaymentsEnabled;bank=settings.BankTransferEnabled;receipt=settings.RequireTransferReceipt;bankName=settings.BankName;beneficiary=settings.BeneficiaryName;clabe=settings.Clabe;instructions=settings.BankTransferInstructions;support=settings.SupportEmail;}async Task Save(){await Billing.SaveSettingsAsync(new(currency,taxRate,pricesIncludeTax,graceDays,card,bank,receipt,false,false,bankName,beneficiary,clabe,instructions,support));message="Configuración guardada.";}async Task SavePlan(){await Billing.SavePlanAsync(new(planId,planCode,planName,currency,p1,p3,p6,p12,planActive));plans=await Billing.GetPlansAsync();planId=plans.First(x=>x.Code==planCode).Id;message="Plan guardado.";}}

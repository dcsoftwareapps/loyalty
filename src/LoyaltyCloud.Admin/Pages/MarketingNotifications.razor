@page "/marketing-notifications"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Globalization
@using System.Net.Http.Json
@using System.Security.Claims
@using LoyaltyCloud.Admin.Auth
@using LoyaltyCloud.Admin.Services
@using LoyaltyCloud.Application.Common.Interfaces
@using LoyaltyCloud.Application.Notifications.Custom
@using LoyaltyCloud.Domain.Entities
@using LoyaltyCloud.Domain.Enums
@using LoyaltyCloud.Domain.Repositories
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@inject AdminApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantRepository Tenants
@inject ITenantLoyaltyLevelReadService TenantLevels
@inject AdminDateTimeFormatter Dates

<PageTitle>Mensajes - LoyaltyCloud</PageTitle>

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;">
    <div>
        <h1>Mensajes personalizados</h1>
        <p class="kb-muted" style="margin-top:-8px;">
            Envia o programa mensajes visibles en Apple Wallet y Google Wallet para audiencias con pase instalado.
        </p>
    </div>
    <button class="kb-btn kb-btn--primary" @onclick="ToggleForm" disabled="@busy">
        @(showForm ? "Cerrar" : "Nuevo mensaje")
    </button>
</div>

@if (successMsg is not null) { <div class="kb-form-success">@successMsg</div> }
@if (errorMsg is not null) { <div class="kb-form-error">@errorMsg</div> }

@if (showForm)
{
    <section class="kb-card" style="margin-bottom:24px;">
        <h2>Mensaje</h2>
        @if (validationErrors.Count > 0)
        {
            <div class="kb-form-error">
                @foreach (var error in validationErrors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <div class="kb-form-row">
            <label for="short-message">Notificación</label>
            <input id="short-message" maxlength="@ShortMessageMaxLength" @bind="form.ShortMessage" @bind:event="oninput" />
            <div class="kb-muted">Este texto aparecerá en la notificación del teléfono.</div>
            <div class="@ShortMessageCounterClass">
                @($"{(form.ShortMessage?.Length ?? 0)}/{ShortMessageMaxLength} · recomendado {ShortMessageRecommendedLength}")
            </div>
        </div>

        <div class="kb-form-row">
            <label for="long-message">Detalle del mensaje</label>
            <textarea id="long-message" rows="5" maxlength="@LongMessageMaxLength" @bind="form.LongMessage" @bind:event="oninput"></textarea>
            <div class="kb-muted">Este contenido se mostrará al consultar el mensaje.</div>
            <div class="kb-muted">@($"{(form.LongMessage?.Length ?? 0)}/{LongMessageMaxLength}")</div>
        </div>

        <div class="kb-form-row kb-form-row--horizontal">
            <div style="flex:1;min-width:220px;">
                <label for="audience-type">Audiencia</label>
                <select id="audience-type" @bind="form.AudienceType">
                    <option value="@CustomNotificationCampaign.AudienceAllWalletUsers">Todos los clientes</option>
                    @foreach (var level in levelOptions)
                    {
                        <option value="@level.Name">Nivel minimo: @level.Name</option>
                    }
                    <option value="@CustomNotificationCampaign.AudienceMinimumPoints">Puntos minimos</option>
                    <option value="@CustomNotificationCampaign.AudiencePointsExpiring">Puntos por expirar</option>
                </select>
            </div>
            @if (CustomNotificationCampaign.IsMinimumPointsAudience(form.AudienceType))
            {
                <div style="flex:1;min-width:180px;">
                    <label for="minimum-points">Puntos mínimos</label>
                    <input id="minimum-points" type="number" min="0" @bind="form.MinimumPoints" />
                </div>
            }
            @if (CustomNotificationCampaign.IsPointsExpiringAudience(form.AudienceType))
            {
                <div style="flex:1;min-width:180px;">
                    <label for="days-ahead">Días adelante</label>
                    <input id="days-ahead" type="number" min="1" @bind="form.PointsExpiringDaysAhead" />
                </div>
            }
        </div>

        <div class="kb-form-row">
            <label for="display-until">Fecha de expiración</label>
            <input id="display-until" type="datetime-local" value="@form.DisplayUntilLocal" @onchange="OnDisplayUntilChanged" />
            <div class="kb-muted">Después de esta fecha, el mensaje dejará de mostrarse en las siguientes actualizaciones de Wallet.</div>
        </div>

        <div class="kb-form-row">
            <label class="kb-checkbox-row" for="schedule-delivery">
                <input id="schedule-delivery" class="kb-checkbox" type="checkbox" @bind="form.ScheduleDelivery" />
                <span>Programar envío</span>
            </label>
        </div>

        @if (!form.SendImmediately)
        {
            <div class="kb-form-row">
                <label for="scheduled-at">Fecha y hora de envío</label>
                <input id="scheduled-at" type="datetime-local" value="@form.ScheduledAtLocal" @onchange="OnScheduledAtChanged" />
            </div>
        }

        <div class="kb-actions-inline">
            <button class="kb-btn kb-btn--ghost" @onclick="PreviewAsync" disabled="@busy">
                Ver audiencia
            </button>
            <button class="kb-btn kb-btn--primary" @onclick="RequestConfirmationAsync" disabled="@busy">
                @(form.SendImmediately ? "Enviar mensaje" : "Programar mensaje")
            </button>
        </div>

        @if (preview is not null)
        {
            <div style="margin-top:16px;padding:16px;border:1px solid #eee;border-radius:8px;background:rgb(250,248,244);">
                <div class="kb-muted" style="font-size:.78rem;text-transform:uppercase;">Audiencia</div>
                <p style="font-size:1.25rem;font-weight:700;margin:4px 0 12px;">@($"{preview.TotalRecipients:N0} destinatarios")</p>
                <div class="kb-actions-inline" style="gap:16px;">
                    <span class="kb-muted">@($"Apple Wallet: {preview.AppleRecipients:N0}")</span>
                    <span class="kb-muted">@($"Google Wallet: {preview.GoogleRecipients:N0}")</span>
                    <span class="kb-muted">@($"Sin Wallet: {preview.ExcludedWithoutDeviceRegistration:N0}")</span>
                </div>
                <p class="kb-muted" style="margin:10px 0 0;">@preview.Criteria</p>
                @if (preview.Warnings.Count > 0)
                {
                    <div class="kb-form-error" style="margin-top:12px;">
                        @foreach (var warning in preview.Warnings)
                        {
                            <div>@warning</div>
                        }
                    </div>
                }
            </div>
        }

        @if (confirmSend)
        {
            <div style="margin-top:16px;padding:16px;border:1px solid #eee;border-radius:8px;">
                <h3 style="margin-top:0;">@(form.SendImmediately ? "¿Enviar este mensaje ahora?" : "¿Programar este mensaje?")</h3>
                <p class="kb-muted">@ConfirmationSummary</p>
                <div class="kb-actions-inline">
                    <button class="kb-btn kb-btn--ghost" @onclick="@(() => confirmSend = false)" disabled="@busy">Cancelar</button>
                    <button class="kb-btn kb-btn--primary" @onclick="CreateAsync" disabled="@busy">
                        @(form.SendImmediately ? "Enviar mensaje" : "Programar mensaje")
                    </button>
                </div>
            </div>
        }
    </section>
}

<section>
    <h2>Historial</h2>
    @if (campaigns is null)
    {
        <p>Cargando...</p>
    }
    else if (campaigns.Count == 0)
    {
        <p class="kb-muted">No hay mensajes personalizados.</p>
    }
    else
    {
        <table class="kb-table kb-table--compact">
            <thead>
                <tr>
                    <th>Creada</th>
                    <th>Nombre</th>
                    <th>Audiencia</th>
                    <th>Notificación / detalle</th>
                    <th>Estado</th>
                    <th>Métricas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var campaign in campaigns)
            {
                <tr>
                    <td class="kb-muted">@FormatDateTime(campaign.CreatedAt)</td>
                    <td>
                        <strong>@campaign.Name</strong>
                    </td>
                    <td>@AudienceText(campaign.AudienceType)</td>
                    <td>
                        <strong>@campaign.ShortMessage</strong>
                        <div class="kb-muted kb-text-truncate" title="@campaign.LongMessage">@campaign.LongMessage</div>
                    </td>
                    <td><span class="@CampaignStatusClass(campaign.Status)">@CampaignStatusText(campaign.Status)</span></td>
                    <td class="kb-muted">@($"{campaign.NotificationsSucceeded}/{campaign.IntendedRecipients} enviadas")</td>
                    <td>
                        <div class="kb-actions-inline">
                            @if (campaign.Status == CustomNotificationCampaignStatus.Scheduled)
                            {
                                <button class="kb-btn kb-btn--primary kb-btn--small" @onclick="@(() => SendAsync(campaign.Id))" disabled="@busy">Enviar</button>
                                <button class="kb-btn kb-btn--ghost kb-btn--small" @onclick="@(() => CancelAsync(campaign.Id))" disabled="@busy">Cancelar</button>
                            }
                            else
                            {
                                <span class="kb-muted">Sin acciones</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@code {
    private const string GeneratedTitle = "NOVEDAD";

    private List<CustomNotificationCampaignDto>? campaigns;
    private CustomNotificationAudiencePreviewDto? preview;
    private CustomMessageForm form = new();
    private IReadOnlyList<TenantLoyaltyLevelDto> levelOptions = [];
    private readonly List<string> validationErrors = new();
    private string? successMsg;
    private string? errorMsg;
    private bool showForm;
    private bool busy;
    private bool confirmSend;

    protected override async Task OnInitializedAsync()
    {
        form = CustomMessageForm.CreateDefault(Dates);
        levelOptions = await TenantLevels.GetActiveLevelsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        busy = true;
        errorMsg = null;
        try
        {
            var result = await Api.GetAsync<List<CustomNotificationCampaignDto>>("api/custom-notification-campaigns?take=100");
            if (result.IsFailure)
            {
                errorMsg = result.Error;
                return;
            }

            campaigns = result.Value;
        }
        finally
        {
            busy = false;
        }
    }

    private void ToggleForm()
    {
        showForm = !showForm;
        successMsg = null;
        errorMsg = null;
        confirmSend = false;
        validationErrors.Clear();
    }

    private async Task PreviewAsync()
    {
        if (!ValidateForm())
            return;

        await LoadPreviewAsync();
    }

    private async Task RequestConfirmationAsync()
    {
        if (!ValidateForm())
            return;

        await LoadPreviewAsync();

        if (errorMsg is null)
            confirmSend = true;
    }

    private async Task LoadPreviewAsync()
    {
        busy = true;
        errorMsg = null;
        successMsg = null;
        confirmSend = false;
        try
        {
            var result = await Api.PostAsJsonAsync<PreviewCustomNotificationAudienceRequest, CustomNotificationAudiencePreviewDto>(
                "api/custom-notification-campaigns/preview",
                new PreviewCustomNotificationAudienceRequest(
                    form.AudienceType,
                    CustomNotificationCampaign.IsMinimumPointsAudience(form.AudienceType) ? form.MinimumPoints : null,
                    CustomNotificationCampaign.IsPointsExpiringAudience(form.AudienceType) ? form.PointsExpiringDaysAhead : null,
                    25));

            if (result.IsFailure)
            {
                errorMsg = result.Error;
                return;
            }

            preview = result.Value;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CreateAsync()
    {
        if (!ValidateForm())
            return;

        busy = true;
        errorMsg = null;
        successMsg = null;
        try
        {
            var shortMessage = NormalizeSingleLine(form.ShortMessage);
            var longMessage = form.LongMessage.Trim();
            var generatedName = await GenerateInternalNameAsync();

            var result = await Api.PostAsJsonAsync<CustomNotificationCampaignRequest, CustomNotificationCampaignDto>(
                "api/custom-notification-campaigns",
                new CustomNotificationCampaignRequest(
                    generatedName,
                    GeneratedTitle,
                    shortMessage,
                    longMessage,
                    form.AudienceType,
                    CustomNotificationCampaign.IsMinimumPointsAudience(form.AudienceType) ? form.MinimumPoints : null,
                    CustomNotificationCampaign.IsPointsExpiringAudience(form.AudienceType) ? form.PointsExpiringDaysAhead : null,
                    form.SendImmediately ? null : form.ScheduledAtUtc,
                    form.DisplayUntilUtc,
                    form.SendImmediately));

            if (result.IsFailure)
            {
                errorMsg = result.Error;
                return;
            }

            successMsg = form.SendImmediately ? "Mensaje enviado." : "Mensaje programado.";
            form = CustomMessageForm.CreateDefault(Dates);
            preview = null;
            confirmSend = false;
            showForm = false;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SendAsync(Guid campaignId)
    {
        busy = true;
        errorMsg = null;
        successMsg = null;
        try
        {
            var result = await Api.PostAsync<CustomNotificationCampaignProcessingDto>($"api/custom-notification-campaigns/{campaignId}/send");
            if (result.IsFailure)
            {
                errorMsg = result.Error;
                return;
            }

            successMsg = "Mensaje enviado.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CancelAsync(Guid campaignId)
    {
        busy = true;
        errorMsg = null;
        successMsg = null;
        try
        {
            var result = await Api.PutAsync<CustomNotificationCampaignDto>($"api/custom-notification-campaigns/{campaignId}/cancel");
            if (result.IsFailure)
            {
                errorMsg = result.Error;
                return;
            }

            successMsg = "Mensaje cancelado.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();
        errorMsg = null;

        var shortMessage = NormalizeSingleLine(form.ShortMessage);
        if (string.IsNullOrWhiteSpace(shortMessage))
            validationErrors.Add("La notificación es obligatoria.");
        else if (shortMessage.Length > ShortMessageMaxLength)
            validationErrors.Add($"La notificación debe tener máximo {ShortMessageMaxLength} caracteres.");

        if (string.IsNullOrWhiteSpace(form.LongMessage))
            validationErrors.Add("El detalle del mensaje es obligatorio.");
        else if (form.LongMessage.Trim().Length > LongMessageMaxLength)
            validationErrors.Add($"El detalle del mensaje debe tener máximo {LongMessageMaxLength} caracteres.");

        var effectiveSendAtUtc = form.SendImmediately ? DateTime.UtcNow : form.ScheduledAtUtc;

        if (form.DisplayUntilUtc <= DateTime.UtcNow)
            validationErrors.Add("La fecha límite de visualización debe ser futura.");
        if (!form.SendImmediately && !form.ScheduledAtUtc.HasValue)
            validationErrors.Add("La fecha de envío es obligatoria para mensajes programados.");
        if (!form.SendImmediately && form.ScheduledAtUtc.HasValue && form.ScheduledAtUtc.Value <= DateTime.UtcNow)
            validationErrors.Add("La fecha de envío debe ser futura.");
        if (effectiveSendAtUtc.HasValue && form.DisplayUntilUtc <= effectiveSendAtUtc.Value)
            validationErrors.Add("La fecha límite de visualización debe ser posterior a la fecha de envío.");
        if (!IsKnownAudience(form.AudienceType) &&
            !levelOptions.Any(level => string.Equals(level.Name, form.AudienceType, StringComparison.OrdinalIgnoreCase)))
        {
            validationErrors.Add("Selecciona una audiencia valida del tenant.");
        }
        if (CustomNotificationCampaign.IsMinimumPointsAudience(form.AudienceType) && form.MinimumPoints.GetValueOrDefault() < 0)
            validationErrors.Add("Los puntos mínimos deben ser cero o mayores.");
        if (CustomNotificationCampaign.IsPointsExpiringAudience(form.AudienceType) && form.PointsExpiringDaysAhead.GetValueOrDefault() <= 0)
            validationErrors.Add("Los días de expiración deben ser mayores a cero.");

        return validationErrors.Count == 0;
    }

    private void OnDisplayUntilChanged(ChangeEventArgs args)
    {
        form.DisplayUntilLocal = args.Value?.ToString() ?? string.Empty;
        form.DisplayUntilUtc = ParseLocalDateTime(form.DisplayUntilLocal) ?? DateTime.UtcNow.AddDays(7);
    }

    private void OnScheduledAtChanged(ChangeEventArgs args)
    {
        form.ScheduledAtLocal = args.Value?.ToString() ?? string.Empty;
        form.ScheduledAtUtc = ParseLocalDateTime(form.ScheduledAtLocal);
    }

    private DateTime? ParseLocalDateTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || !DateTime.TryParse(value, out var parsed))
            return null;

        return Dates.LocalDateTimeToUtc(parsed);
    }

    private string ToInputValue(DateTime utc) =>
        Dates.DateTimeInput(utc);

    private string FormatDateTime(DateTime value) => Dates.DateTime(value);
    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "No disponible" : value;
    private string ConfirmationSummary =>
        preview is null
            ? $"Audiencia: {AudienceText(form.AudienceType)}."
            : form.SendImmediately
                ? $"Se enviará a {preview.TotalRecipients:N0} destinatarios. Audiencia: {AudienceText(form.AudienceType)}."
                : $"Se enviará el {DisplayText(form.ScheduledAtUtc.HasValue ? Dates.DateTime(form.ScheduledAtUtc.Value) : null)} a {preview.TotalRecipients:N0} destinatarios. Audiencia: {AudienceText(form.AudienceType)}.";

    private static bool IsKnownAudience(string audienceType) =>
        CustomNotificationCampaign.IsAllWalletUsersAudience(audienceType) ||
        CustomNotificationCampaign.IsMinimumPointsAudience(audienceType) ||
        CustomNotificationCampaign.IsPointsExpiringAudience(audienceType);

    private static string AudienceText(string audienceType)
    {
        if (CustomNotificationCampaign.IsAllWalletUsersAudience(audienceType))
            return "Todos los clientes";
        if (CustomNotificationCampaign.IsMinimumPointsAudience(audienceType))
            return "Puntos minimos";
        if (CustomNotificationCampaign.IsPointsExpiringAudience(audienceType))
            return "Puntos por expirar";

        return $"Desde {audienceType}";
    }

    private async Task<string> GenerateInternalNameAsync()
    {
        var tenantTimeZone = await ResolveTenantTimeZoneAsync();
        var tenantLocalTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tenantTimeZone);
        return $"Mensaje {tenantLocalTime.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)}";
    }

    private async Task<TimeZoneInfo> ResolveTenantTimeZoneAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var tenantIdValue = authState.User.FindFirstValue(AdminClaimTypes.TenantId);
        if (!Guid.TryParse(tenantIdValue, out var tenantId))
            throw new InvalidOperationException("No se encontró tenant en la sesión actual.");

        var tenant = await Tenants.GetByIdAsync(tenantId);
        if (tenant is null)
            throw new InvalidOperationException("No se encontró configuración del tenant actual.");

        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(tenant.TimeZoneId);
        }
        catch (TimeZoneNotFoundException ex)
        {
            throw new InvalidOperationException($"Zona horaria del tenant no válida: {tenant.TimeZoneId}.", ex);
        }
        catch (InvalidTimeZoneException ex)
        {
            throw new InvalidOperationException($"Zona horaria del tenant no válida: {tenant.TimeZoneId}.", ex);
        }
    }

    private static string NormalizeSingleLine(string? value)
    {
        var clean = (value ?? string.Empty)
            .Replace('\r', ' ')
            .Replace('\n', ' ')
            .Replace('\t', ' ')
            .Trim();

        while (clean.Contains("  ", StringComparison.Ordinal))
            clean = clean.Replace("  ", " ", StringComparison.Ordinal);

        return clean;
    }

    private string ShortMessageCounterClass =>
        NormalizeSingleLine(form.ShortMessage).Length <= ShortMessageRecommendedLength
            ? "kb-muted"
            : "kb-form-warning";

    private static string CampaignStatusText(CustomNotificationCampaignStatus status) => status switch
    {
        CustomNotificationCampaignStatus.Completed => "Completada",
        CustomNotificationCampaignStatus.PartiallyCompleted => "Completada parcialmente",
        CustomNotificationCampaignStatus.Failed => "Fallida",
        CustomNotificationCampaignStatus.Cancelled => "Cancelada",
        CustomNotificationCampaignStatus.Scheduled => "Programada",
        CustomNotificationCampaignStatus.Processing => "Procesando",
        _ => "Borrador"
    };

    private static string CampaignStatusClass(CustomNotificationCampaignStatus status) => status switch
    {
        CustomNotificationCampaignStatus.Completed => "kb-badge kb-badge--success",
        CustomNotificationCampaignStatus.PartiallyCompleted => "kb-badge kb-badge--warning",
        CustomNotificationCampaignStatus.Failed => "kb-badge kb-badge--danger",
        CustomNotificationCampaignStatus.Cancelled => "kb-badge kb-badge--muted",
        CustomNotificationCampaignStatus.Scheduled => "kb-badge kb-badge--info",
        CustomNotificationCampaignStatus.Processing => "kb-badge kb-badge--warning",
        _ => "kb-badge kb-badge--muted"
    };

    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ProblemDetails>();
            if (!string.IsNullOrWhiteSpace(problem?.Detail))
                return problem.Detail;
            if (!string.IsNullOrWhiteSpace(problem?.Title))
                return problem.Title;
        }
        catch
        {
            // Fall through to raw content.
        }

        var content = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(content)
            ? $"La API respondió {(int)response.StatusCode} {response.ReasonPhrase}."
            : content;
    }

    private sealed record PreviewCustomNotificationAudienceRequest(
        string AudienceType,
        int? MinimumPoints,
        int? PointsExpiringDaysAhead,
        int? SampleSize);

    private sealed record CustomNotificationCampaignRequest(
        string Name,
        string Title,
        string ShortMessage,
        string LongMessage,
        string AudienceType,
        int? MinimumPoints,
        int? PointsExpiringDaysAhead,
        DateTime? ScheduledAtUtc,
        DateTime DisplayUntilUtc,
        bool SendImmediately);

    private enum CustomMessageSendMode
    {
        SendNow,
        Schedule
    }

    private sealed class CustomMessageForm
    {
        public string ShortMessage { get; set; } = string.Empty;
        public string LongMessage { get; set; } = string.Empty;
        public string AudienceType { get; set; } = CustomNotificationCampaign.AudienceAllWalletUsers;
        public int? MinimumPoints { get; set; } = 0;
        public int? PointsExpiringDaysAhead { get; set; } = 15;
        public CustomMessageSendMode SendMode { get; set; } = CustomMessageSendMode.SendNow;
        public bool SendImmediately => SendMode == CustomMessageSendMode.SendNow;
        public bool ScheduleDelivery
        {
            get => SendMode == CustomMessageSendMode.Schedule;
            set
            {
                SendMode = value ? CustomMessageSendMode.Schedule : CustomMessageSendMode.SendNow;
                if (!value)
                {
                    ScheduledAtLocal = null;
                    ScheduledAtUtc = null;
                }
            }
        }
        public DateTime? ScheduledAtUtc { get; set; }
        public DateTime DisplayUntilUtc { get; set; }
        public string? ScheduledAtLocal { get; set; }
        public string DisplayUntilLocal { get; set; } = string.Empty;

        public static CustomMessageForm CreateDefault(AdminDateTimeFormatter dates)
        {
            var displayUntil = DateTime.UtcNow.AddDays(7);
            return new CustomMessageForm
            {
                DisplayUntilUtc = displayUntil,
                DisplayUntilLocal = dates.DateTimeInput(displayUntil)
            };
        }
    }

    private const int ShortMessageRecommendedLength = 35;
    private const int ShortMessageMaxLength = 40;
    private const int LongMessageMaxLength = 500;
}

@page "/config"
@attribute [Authorize]
@rendermode InteractiveServer

@using LoyaltyCloud.Application.Config.Commands.UpdateProgramConfig
@using LoyaltyCloud.Application.Config.Queries.GetProgramConfig
@using LoyaltyCloud.Application.Common.Branding
@using LoyaltyCloud.Application.Common.Interfaces
@using LoyaltyCloud.Common.Constants
@using Microsoft.AspNetCore.Components.Forms
@using LoyaltyCloud.Admin.Services
@inject ISender Sender
@inject ITenantBrandingReadService BrandingRead
@inject AdminApiClient Api

<PageTitle>Configuración · LoyaltyCloud</PageTitle>

<header class="kb-page-header"><div><span class="kb-eyebrow">Gestión</span><h1>Diseño y configuración</h1><p>Administra la identidad visual y las reglas de tus programas.</p></div></header>
<nav class="kb-report-nav" aria-label="Secciones de diseño y configuración">
    <a class="@(IsDigitalCardTab ? "active" : null)" href="/config">Tarjeta digital</a>
    <a class="@(IsGiftCardsTab ? "active" : null)" href="/config?section=giftcards">Tarjetas de regalo</a>
    <a class="@(IsPointsBenefitsTab ? "active" : null)" href="/config?section=points">Puntos y beneficios</a>
</nav>
@if (IsGiftCardsTab) { <GiftCardSettingsPanel /> } else {

@if (entries is null)
{
    <p>Cargando…</p>
}
else
{
    @if (successMsg is not null) { <div class="kb-form-success">@successMsg</div> }
    @if (errorMsg is not null) { <div class="kb-form-error">@errorMsg</div> }

    @if (IsDigitalCardTab)
    {
    <section class="kb-card kb-config-card">
        <h2>Tarjeta digital</h2>
        <p class="kb-muted">Personaliza el diseño de tu tarjeta digital.</p>

        <div class="kb-wallet-config">
            <div class="kb-wallet-form">
                <div class="kb-form-row">
                    <label for="wallet-bg">Color de tarjeta</label>
                    <div class="kb-color-input-group">
                        <input id="wallet-bg-picker"
                               class="kb-color-picker"
                               type="color"
                               value="@WalletPickerColor"
                               @oninput="OnWalletColorChanged" />
                        <input id="wallet-bg"
                               type="text"
                               value="@WalletColorInputValue"
                               @oninput="OnWalletColorChanged"
                               placeholder="#1C1C1C"
                               maxlength="7" />
                    </div>
                </div>

                <div class="kb-form-row">
                    <label for="wallet-logo">Logo de la tarjeta</label>
                    <label class="kb-file-upload">
                        <span class="kb-btn kb-btn--ghost kb-btn--small">Cambiar logo</span>
                        <InputFile id="wallet-logo"
                                   class="kb-file-input-hidden"
                                   OnChange="UploadWalletLogoAsync"
                                   accept="image/png,image/jpeg"
                                   disabled="@brandingBusy" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(selectedWalletLogoFileName))
                    {
                        <span class="kb-file-name">@selectedWalletLogoFileName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(branding?.WalletLogoUrl))
                    {
                        <div class="kb-logo-preview">
                            <img src="@branding.WalletLogoUrl" alt="Logo de la tarjeta" />
                        </div>
                    }
                    <small class="kb-muted">Recomendado: PNG de alta resolución con fondo transparente y poco espacio vacío alrededor del logo. Mantén la proporción original.</small>
                </div>

                <div class="kb-form-row">
                    <label for="wallet-logo-scale">Tamaño del logo <span class="kb-range-value">@walletLogoScalePercent%</span></label>
                    <input id="wallet-logo-scale"
                           class="kb-range"
                           type="range"
                           min="60"
                           max="100"
                           step="5"
                           value="@walletLogoScalePercent"
                           @oninput="OnWalletLogoScaleChanged"
                           disabled="@brandingBusy" />
                    <small class="kb-muted">Ajusta qué tan grande se verá el logo en Apple Wallet.</small>
                </div>

                <div class="kb-form-row">
                    <label>Contenido principal</label>
                    <div class="kb-radio-stack">
                        <label class="kb-radio-option">
                            <input type="radio"
                                   name="apple-wallet-primary-content"
                                   value="@PrimaryContentCustomerName"
                                   checked="@IsCustomerNameMode"
                                   @onchange="OnPrimaryContentModeChanged"
                                   disabled="@brandingBusy" />
                            <span>Nombre del cliente</span>
                        </label>
                        <label class="kb-radio-option">
                            <input type="radio"
                                   name="apple-wallet-primary-content"
                                   value="@PrimaryContentImage"
                                   checked="@IsImageMode"
                                   @onchange="OnPrimaryContentModeChanged"
                                   disabled="@brandingBusy" />
                            <span>Imagen de portada</span>
                        </label>
                    </div>
                </div>

                @if (IsImageMode)
                {
                    <div class="kb-form-row">
                        <label for="wallet-strip">Imagen de portada</label>
                        <label class="kb-file-upload">
                            <span class="kb-btn kb-btn--ghost kb-btn--small">Cambiar portada</span>
                            <InputFile id="wallet-strip"
                                       class="kb-file-input-hidden"
                                       OnChange="UploadAppleWalletStripImageAsync"
                                       accept="image/png,image/jpeg"
                                       disabled="@brandingBusy" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(selectedAppleWalletStripFileName))
                        {
                            <span class="kb-file-name">@selectedAppleWalletStripFileName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(branding?.AppleWalletStripImageUrl))
                        {
                            <div class="kb-strip-preview">
                                <img src="@branding.AppleWalletStripImageUrl" alt="Imagen de portada de Apple Wallet" />
                            </div>
                        }
                        <small class="kb-muted">Tamaño recomendado: 1125 × 432 px. Usa una imagen horizontal. Se recortará automáticamente para ajustarse sin deformarse.</small>
                    </div>
                }

                <div class="kb-form-row kb-form-row--horizontal">
                    <button class="kb-btn kb-btn--primary kb-config-save"
                            @onclick="SaveWalletBrandingAsync"
                            disabled="@brandingBusy">
                        @(brandingBusy ? "Guardando…" : "Guardar")
                    </button>
                </div>
            </div>

            <div class="kb-wallet-preview-shell">
                <div class="kb-wallet-preview"
                     style="background:@ResolvedWalletBackground; color:@ResolvedWalletText;">
                    <div class="kb-wallet-preview-logo">
                        @if (!string.IsNullOrWhiteSpace(branding?.WalletLogoUrl))
                        {
                            <img src="@branding.WalletLogoUrl" alt="" style="@WalletLogoPreviewStyle" />
                        }
                        else
                        {
                            <strong>@(branding?.DisplayName ?? "LoyaltyCloud")</strong>
                        }
                    </div>

                    @if (IsCustomerNameMode)
                    {
                        <div class="kb-wallet-preview-name">Daniel</div>
                    }
                    else
                    {
                        <div class="kb-wallet-preview-strip">
                            @if (!string.IsNullOrWhiteSpace(branding?.AppleWalletStripImageUrl))
                            {
                                <img src="@branding.AppleWalletStripImageUrl" alt="" />
                            }
                            else
                            {
                                <span>Imagen de portada</span>
                            }
                        </div>
                    }

                    <div class="kb-wallet-preview-field-labels">
                        <span>PUNTOS</span>
                        <span>NIVEL</span>
                        <span>PRÓXIMO</span>
                        <span>FALTAN</span>
                    </div>
                    <div class="kb-wallet-preview-field-values">
                        <strong>50 pts</strong>
                        <strong>Mist ✨</strong>
                        <strong>Glow</strong>
                        <strong>950 pts</strong>
                    </div>

                    <div class="kb-wallet-preview-qr">
                        @* Preview-only QR; the real Wallet pass barcode payload is generated elsewhere. *@
                        <img src="@PreviewQrDataUri" alt="" />
                    </div>
                </div>
                <p class="kb-wallet-preview-note">
                    Vista previa aproximada.
                </p>
            </div>
        </div>
    </section>
    }
    else if (IsPointsBenefitsTab)
    {
    <section class="kb-card kb-config-card kb-config-card--rules">
        <h2>Reglas de puntos y beneficios</h2>
        <p class="kb-muted">Define cómo se acumulan, vencen y bonifican los puntos de tu programa.</p>

        <table class="kb-table kb-config-rules-table">
            <thead>
                <tr>
                    <th>Regla</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in entries)
            {
                <tr>
                    <td>
                        <strong>@FriendlyName(e.Key)</strong>
                        @if (!string.IsNullOrWhiteSpace(e.Description))
                        {
                            <br/><small style="color:var(--kb-ink-muted);">@e.Description</small>
                        }
                    </td>
                    <td>
                        @if (IsPointsExpirationEnabled(e.Key))
                        {
                            <select @bind="edited[e.Key]" style="max-width: 160px;">
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        }
                        else
                        {
                            <input type="text" @bind="edited[e.Key]" style="max-width: 160px;" />
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <button class="kb-btn kb-btn--primary kb-config-save"
                @onclick="SaveAsync" disabled="@busy">
            @(busy ? "Guardando…" : "Guardar")
        </button>
    </section>
    }
}

}

@code {
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    private bool IsGiftCardsTab => string.Equals(Section, "giftcards", StringComparison.OrdinalIgnoreCase);
    private bool IsPointsBenefitsTab => string.Equals(Section, "points", StringComparison.OrdinalIgnoreCase);
    private bool IsDigitalCardTab => !IsGiftCardsTab && !IsPointsBenefitsTab;
    private List<ConfigDto>? entries;
    private Dictionary<string, string> edited = new();
    private string? successMsg;
    private string? errorMsg;
    private bool busy;
    private TenantBrandingInfo? branding;
    private string? walletBackgroundColor;
    private int walletLogoScalePercent = 100;
    private string appleWalletPrimaryContentMode = PrimaryContentCustomerName;
    private bool brandingBusy;
    private string? selectedWalletLogoFileName;
    private string? selectedAppleWalletStripFileName;
    private const long MaxLogoBytes = 2 * 1024 * 1024;
    private const string PrimaryContentCustomerName = "CustomerName";
    private const string PrimaryContentImage = "Image";
    private const string PreviewQrUrl = "https://www.instagram.com/loyaltycloud.app/";
    private static readonly string PreviewQrDataUri = QrCodeSvgGenerator.GenerateDataUri(PreviewQrUrl, scale: 7);

    private string WalletColorInputValue => !string.IsNullOrWhiteSpace(walletBackgroundColor)
        ? walletBackgroundColor
        : ResolvedWalletBackground;
    private string WalletPickerColor => WalletColorContrast.NormalizeHexOrDefault(WalletColorInputValue, WalletColorContrast.DefaultBackgroundHex);
    private string ResolvedWalletBackground => WalletColorContrast.NormalizeHexOrDefault(
        string.IsNullOrWhiteSpace(walletBackgroundColor) ? branding?.ResolvedWalletBackgroundColor : walletBackgroundColor,
        WalletColorContrast.DefaultBackgroundHex);
    private string ResolvedWalletText => WalletColorContrast.ResolveTextColors(ResolvedWalletBackground).ForegroundHex;
    private string WalletLogoPreviewStyle => $"width:{Math.Round(180 * (walletLogoScalePercent / 100d)):0}px;";
    private bool IsCustomerNameMode => !string.Equals(appleWalletPrimaryContentMode, PrimaryContentImage, StringComparison.OrdinalIgnoreCase);
    private bool IsImageMode => string.Equals(appleWalletPrimaryContentMode, PrimaryContentImage, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Sender.Send(new GetProgramConfigQuery());
        if (result.IsSuccess)
        {
            entries = result.Value
                .Where(IsVisibleConfigEntry)
                .ToList();
            edited = entries.ToDictionary(e => e.Key, e => e.Value);
        }

        branding = await BrandingRead.GetCurrentAsync();
        walletBackgroundColor = branding.WalletBackgroundColor ?? string.Empty;
        walletLogoScalePercent = branding.WalletLogoScalePercent;
        appleWalletPrimaryContentMode = NormalizePrimaryContentMode(branding.AppleWalletPrimaryContentMode);
        selectedWalletLogoFileName = null;
        selectedAppleWalletStripFileName = null;
    }

    private async Task SaveAsync()
    {
        successMsg = errorMsg = null;
        busy = true;

        // Solo enviar las claves que cambiaron.
        var changed = entries!
            .Where(e => edited[e.Key] != e.Value)
            .Select(e => new ConfigEntry(e.Key, edited[e.Key]))
            .ToList();

        if (changed.Count == 0)
        {
            successMsg = "Sin cambios para guardar.";
            busy = false;
            return;
        }

        var result = await Sender.Send(new UpdateProgramConfigCommand(changed, "admin-panel"));
        busy = false;

        if (result.IsSuccess)
        {
            successMsg = $"Guardadas {changed.Count} regla(s).";
            await LoadAsync();
        }
        else
        {
            errorMsg = result.Error;
        }
    }

    private void OnWalletColorChanged(ChangeEventArgs args)
    {
        walletBackgroundColor = args.Value?.ToString()?.Trim() ?? string.Empty;
    }

    private void OnWalletLogoScaleChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            walletLogoScalePercent = Math.Clamp(value, 60, 100);
        }
    }

    private void OnPrimaryContentModeChanged(ChangeEventArgs args)
    {
        appleWalletPrimaryContentMode = NormalizePrimaryContentMode(args.Value?.ToString());
    }

    private async Task SaveWalletBrandingAsync()
    {
        successMsg = errorMsg = null;
        if (!string.IsNullOrWhiteSpace(walletBackgroundColor) && !WalletColorContrast.IsHexColor(walletBackgroundColor))
        {
            errorMsg = "El color de la tarjeta debe usar formato #RRGGBB.";
            return;
        }
        if (IsImageMode && branding?.HasAppleWalletStripImage != true)
        {
            errorMsg = "Sube una imagen de portada antes de seleccionar esta opción.";
            return;
        }

        brandingBusy = true;
        try
        {
            var result = await Api.PutAsJsonAsync<WalletBrandingRequest, TenantBrandingInfo>(
                "api/config/wallet-branding",
                new WalletBrandingRequest(walletBackgroundColor, walletLogoScalePercent, appleWalletPrimaryContentMode));
            if (result.IsSuccess)
            {
                branding = result.Value;
                walletBackgroundColor = branding.WalletBackgroundColor ?? string.Empty;
                walletLogoScalePercent = branding.WalletLogoScalePercent;
                appleWalletPrimaryContentMode = NormalizePrimaryContentMode(branding.AppleWalletPrimaryContentMode);
                successMsg = "Tarjeta digital actualizada.";
            }
            else
            {
                errorMsg = result.Error;
            }
        }
        finally
        {
            brandingBusy = false;
        }
    }

    private async Task UploadWalletLogoAsync(InputFileChangeEventArgs args)
    {
        successMsg = errorMsg = null;
        var file = args.File;
        selectedWalletLogoFileName = file.Name;
        if (file.Size <= 0 || file.Size > MaxLogoBytes)
        {
            errorMsg = "El logo debe pesar máximo 2 MB.";
            return;
        }

        if (!file.ContentType.Equals("image/png", StringComparison.OrdinalIgnoreCase)
            && !file.ContentType.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase)
            && !file.ContentType.Equals("image/jpg", StringComparison.OrdinalIgnoreCase))
        {
            errorMsg = "El logo debe ser PNG o JPG.";
            return;
        }

        brandingBusy = true;
        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(MaxLogoBytes))
            await using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            var result = await Api.PostAsJsonAsync<WalletLogoUploadRequest, TenantBrandingInfo>(
                "api/config/wallet-branding/logo",
                new WalletLogoUploadRequest(
                file.Name,
                file.ContentType,
                    Convert.ToBase64String(bytes),
                    file.Size));

            if (result.IsFailure)
            {
                errorMsg = string.Join(" ", result.Errors);
                return;
            }

            branding = result.Value;
            walletLogoScalePercent = branding.WalletLogoScalePercent;
            successMsg = "Logo de tarjeta actualizado.";
            selectedWalletLogoFileName = null;
        }
        finally
        {
            brandingBusy = false;
        }
    }

    private async Task UploadAppleWalletStripImageAsync(InputFileChangeEventArgs args)
    {
        successMsg = errorMsg = null;
        var file = args.File;
        selectedAppleWalletStripFileName = file.Name;
        if (file.Size <= 0 || file.Size > MaxLogoBytes)
        {
            errorMsg = "La imagen de portada debe pesar máximo 2 MB.";
            return;
        }

        if (!file.ContentType.Equals("image/png", StringComparison.OrdinalIgnoreCase)
            && !file.ContentType.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase)
            && !file.ContentType.Equals("image/jpg", StringComparison.OrdinalIgnoreCase))
        {
            errorMsg = "La imagen de portada debe ser PNG o JPG.";
            return;
        }

        brandingBusy = true;
        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(MaxLogoBytes))
            await using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            var result = await Api.PostAsJsonAsync<WalletLogoUploadRequest, TenantBrandingInfo>(
                "api/config/wallet-branding/strip-image",
                new WalletLogoUploadRequest(
                    file.Name,
                    file.ContentType,
                    Convert.ToBase64String(bytes),
                    file.Size));

            if (result.IsFailure)
            {
                errorMsg = string.Join(" ", result.Errors);
                return;
            }

            branding = result.Value;
            selectedAppleWalletStripFileName = null;
            successMsg = "Imagen de portada actualizada.";
        }
        finally
        {
            brandingBusy = false;
        }
    }


    // Mapping legible para mostrar en la tabla; no afecta los keys reales.
    private static bool IsVisibleConfigEntry(ConfigDto entry) =>
        !entry.Key.StartsWith("reward_", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Key, LoyaltyConstants.ConfigKeys.LevelMistMin, StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Key, LoyaltyConstants.ConfigKeys.LevelGlowMin, StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Key, LoyaltyConstants.ConfigKeys.LevelRadianceMin, StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Key, LoyaltyConstants.ConfigKeys.RadianceRequalificationPoints, StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Key, LoyaltyConstants.ConfigKeys.ReferralBonusPoints, StringComparison.OrdinalIgnoreCase);

    private static bool IsPointsExpirationEnabled(string key) =>
        string.Equals(key, LoyaltyConstants.ConfigKeys.PointsExpirationEnabled, StringComparison.OrdinalIgnoreCase);

    private static string FriendlyName(string key) => key switch
    {
        LoyaltyConstants.ConfigKeys.PointsPerPesoUnit => "Pesos por 1 punto",
        LoyaltyConstants.ConfigKeys.WelcomeBonusPoints => "Puntos de bienvenida",
        LoyaltyConstants.ConfigKeys.BirthdayMultiplier => "Multiplicador cumpleaños",
        LoyaltyConstants.ConfigKeys.PointsExpirationEnabled => "Expiracion de puntos activa",
        LoyaltyConstants.ConfigKeys.PointsExpireAfterMonths => "Meses de vigencia de puntos",
        LoyaltyConstants.ConfigKeys.LevelMistMin => "Umbral Mist",
        LoyaltyConstants.ConfigKeys.LevelGlowMin => "Umbral Glow",
        LoyaltyConstants.ConfigKeys.LevelRadianceMin => "Umbral Radiance",
        LoyaltyConstants.ConfigKeys.RadianceRequalificationPoints => "Re-cualificación Radiance (pts/año)",
        _ => key
    };

    private sealed record WalletBrandingRequest(
        string? WalletBackgroundColor,
        int WalletLogoScalePercent,
        string AppleWalletPrimaryContentMode);

    private sealed record WalletLogoUploadRequest(
        string FileName,
        string ContentType,
        string ContentBase64,
        long ContentLength);

    private static string NormalizePrimaryContentMode(string? value) =>
        string.Equals(value, PrimaryContentImage, StringComparison.OrdinalIgnoreCase)
            ? PrimaryContentImage
            : PrimaryContentCustomerName;
}

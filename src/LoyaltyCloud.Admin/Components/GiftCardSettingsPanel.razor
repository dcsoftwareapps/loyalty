@using LoyaltyCloud.Domain.Enums
@using LoyaltyCloud.Application.GiftCards
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService Service
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantBrandingReadService TenantBranding
@inject LoyaltyCloud.Admin.Services.GiftCardFeatureState FeatureState

@if(settings is null){<div class="kb-panel kb-empty-state"><p>Cargando configuración…</p></div>}
else{
@if(error is not null){<div class="kb-form-error" role="alert">@error</div>} @if(success is not null){<div class="kb-form-success" role="status">@success</div>}
<div class="kb-config-section-heading"><div><h2>Tarjetas de regalo</h2><p>Define cómo se emiten, usan y presentan las tarjetas de regalo de tu negocio.</p></div><button class="kb-btn kb-btn--primary" disabled="@busy" @onclick="Save">@(busy ? "Guardando…" : "Guardar cambios")</button></div><div class="kb-gift-settings-layout"><div class="kb-gift-settings-form">
<section class="kb-panel"><div class="kb-section-heading"><div><h2>Disponibilidad y uso</h2><p>Controla la operación del módulo para este tenant.</p></div></div>
<label class="kb-switch-row"><span><strong>Tarjetas de regalo habilitadas</strong><small>Permite emitir, consultar y canjear tarjetas.</small></span><input type="checkbox" @bind="enabled" /></label>
<label class="kb-switch-row"><span><strong>Monto personalizado</strong><small>Permite capturar un importe diferente a las denominaciones.</small></span><input type="checkbox" @bind="custom" /></label>
<label class="kb-switch-row"><span><strong>Canje parcial</strong><small>Conserva el saldo restante después de un canje.</small></span><input type="checkbox" @bind="partial" /></label></section>
<section class="kb-panel"><div class="kb-section-heading"><div><h2>Reglas</h2><p>Vigencia y valores rápidos disponibles.</p></div></div><div class="kb-form-grid"><label class="kb-field"><span>Expiración</span><select @bind="expiration"><option value="Never">Sin expiración</option><option value="MonthsAfterIssue">Meses después de emitir</option><option value="SelectAtIssue">Elegir al emitir</option></select></label>@if(expiration=="MonthsAfterIssue"){<label class="kb-field"><span>Meses de vigencia</span><input type="number" min="1" max="120" @bind="months" /></label>}</div>
<div class="kb-denomination-add"><label class="kb-field"><span>Nueva denominación</span><input type="number" min="0.01" step="0.01" @bind="newAmount" /></label><button class="kb-btn kb-btn--ghost" disabled="@busy" @onclick="Add">Agregar</button></div>
<div class="kb-denomination-list">@if(settings.Denominations.Count==0){<p class="kb-muted">Aún no hay denominaciones.</p>}@foreach(var d in settings.Denominations){<div><span><strong>@d.Amount.ToString("N2") @d.Currency</strong><small>@(d.IsActive?"Disponible":"Inactiva")</small></span><button class="kb-btn kb-btn--ghost" disabled="@busy" @onclick="()=>Toggle(d)">@(d.IsActive?"Desactivar":"Activar")</button></div>}</div></section>
<section class="kb-panel"><div class="kb-section-heading"><div><h2>Identidad visual</h2><p>Personaliza la tarjeta sin alterar la marca general del tenant.</p></div></div><div class="kb-form-grid"><label class="kb-field kb-field--wide"><span>Nombre visible</span><input maxlength="100" @bind="displayName" /></label><label class="kb-field"><span>Color principal</span><div class="kb-color-control"><input type="color" @bind="primaryColor" /><input maxlength="7" @bind="primaryColor" /></div></label><label class="kb-field"><span>Color de texto</span><div class="kb-color-control"><input type="color" @bind="textColor" /><input maxlength="7" @bind="textColor" /></div></label><label class="kb-field kb-field--wide"><span>Logo (URL)</span><input type="url" @bind="logoUrl" placeholder="https://…" /></label><label class="kb-field kb-field--wide"><span>Texto secundario</span><input maxlength="160" @bind="secondaryText" /></label><label class="kb-field kb-field--wide"><span>Términos y condiciones</span><textarea rows="5" maxlength="4000" @bind="terms"></textarea></label><label class="kb-field kb-field--wide"><span>Mensaje al pie</span><input maxlength="250" @bind="footerMessage" /></label></div></section>
</div><aside class="kb-gift-preview-panel"><span class="kb-eyebrow">Vista previa</span><GiftCardVisual DisplayName="@PreviewBranding.DisplayName" BackgroundColor="@PreviewBranding.BackgroundColor" TextColor="@PreviewBranding.TextColor" LogoUrl="@PreviewBranding.LogoUrl" SenderName="Loyalty" Balance="$200" Currency="" Code="GC-••••-••••-••••" ShowCategoryLabel="false" ShowSecondaryText="false" ShowRecipient="false" ShowBalanceLabel="false" ShowCurrency="false" ShowExpiration="false" /><p>La vista previa se actualiza antes de guardar.</p></aside></div>}
@code {
 LoyaltyCloud.Application.GiftCards.GiftCardSettingsDto? settings; LoyaltyCloud.Application.Common.Interfaces.TenantBrandingInfo? tenantPresentation; bool enabled,custom,partial,promotional,busy; string currency="MXN",displayName="Tarjeta de regalo",primaryColor="#1C1B18",textColor="#FFFFFF",expiration="Never"; int? months; string? logoUrl,secondaryText,terms,footerMessage,error,success; decimal newAmount;
 EffectiveGiftCardBranding PreviewBranding=>GiftCardBrandingResolver.Resolve(primaryColor,textColor,displayName,logoUrl,tenantPresentation?.ResolvedWalletBackgroundColor,tenantPresentation?.DisplayName,tenantPresentation?.WalletLogoUrl??tenantPresentation?.LogoUrl); string PreviewStyle=>$"--gift-bg:{PreviewBranding.BackgroundColor};--gift-text:{PreviewBranding.TextColor}";
 protected override async Task OnInitializedAsync(){try{settings=await Service.GetSettingsAsync();tenantPresentation=await TenantBranding.GetCurrentAsync();Copy();}catch(ArgumentException ex){error=ex.Message;}catch(InvalidOperationException ex){error=Friendly(ex.Message);}catch(Exception){error="No fue posible completar la operación. Intenta nuevamente.";}}
 void Copy(){if(settings is null)return;enabled=settings.IsEnabled;custom=settings.AllowCustomAmount;partial=settings.AllowPartialRedemption;promotional=settings.AllowPromotionalIssuance;currency=settings.Currency;displayName=settings.DisplayName;primaryColor=settings.PrimaryColor;textColor=settings.TextColor;expiration=settings.ExpirationMode.ToString();months=settings.DefaultExpirationMonths;logoUrl=settings.LogoUrl;secondaryText=settings.SecondaryText;terms=settings.Terms;footerMessage=settings.FooterMessage;}
 static string Friendly(string value)=>value.Contains("GoogleWallet",StringComparison.OrdinalIgnoreCase)||value.Contains("IssuerId",StringComparison.OrdinalIgnoreCase)?"El proveedor Wallet no está configurado para este entorno.":value; async Task Save(){try{busy=true;error=success=null;settings=await Service.UpdateSettingsAsync(new(enabled,custom,partial,promotional,Enum.Parse<GiftCardExpirationMode>(expiration),expiration=="MonthsAfterIssue"?months:null,currency,displayName,primaryColor,textColor,logoUrl,secondaryText,terms,footerMessage));Copy();await FeatureState.NotifyAsync(enabled);success=settings.SyncWarning??"Configuración guardada correctamente.";}catch(ArgumentException ex){error=ex.Message;}catch(InvalidOperationException ex){error=Friendly(ex.Message);}catch(Exception){error="No fue posible completar la operación. Intenta nuevamente.";}finally{busy=false;}}
 async Task Add(){try{busy=true;error=success=null;await Service.AddDenominationAsync(newAmount);settings=await Service.GetSettingsAsync();newAmount=0;success="Denominación agregada.";}catch(ArgumentException ex){error=ex.Message;}catch(InvalidOperationException ex){error=Friendly(ex.Message);}catch(Exception){error="No fue posible completar la operación. Intenta nuevamente.";}finally{busy=false;}}
 async Task Toggle(LoyaltyCloud.Application.GiftCards.GiftCardDenominationDto d){try{busy=true;error=success=null;await Service.SetDenominationActiveAsync(d.Id,!d.IsActive);settings=await Service.GetSettingsAsync();success="Denominación actualizada.";}catch(ArgumentException ex){error=ex.Message;}catch(InvalidOperationException ex){error=Friendly(ex.Message);}catch(Exception){error="No fue posible completar la operación. Intenta nuevamente.";}finally{busy=false;}}
}



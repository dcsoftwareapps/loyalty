@inherits LayoutComponentBase
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantBrandingReadService Branding
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantContext TenantContext
@inject LoyaltyCloud.Admin.Auth.AdminAuthService Auth
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject LoyaltyCloud.Application.GiftCards.IGiftCardService GiftCards
@inject LoyaltyCloud.Admin.Services.GiftCardFeatureState GiftCardFeatureState
@inject LoyaltyCloud.Application.Common.Interfaces.ITenantProgramReadService Programs
@inject LoyaltyCloud.Admin.Auth.AdminTenantContextInitializer TenantInitializer
@implements IDisposable

@if (canRender)
{
    <div class="kb-app" style="@TenantStyle">
        <header class="kb-mobile-header">
            <div class="kb-mobile-brand"><span class="kb-brand-mark">L</span><strong>LoyaltyCloud</strong></div>
            <button type="button" class="kb-icon-button" aria-label="Abrir navegación" aria-expanded="false" data-admin-menu-toggle><NavIcon Name="menu" /></button>
        </header>
        <button type="button" class="kb-sidebar-backdrop" aria-label="Cerrar navegación" data-admin-menu-close></button>

        <aside class="kb-sidebar" aria-label="Navegación principal">
            <div class="kb-sidebar-brand">
                <div class="kb-brand-identity">
                    @if (!string.IsNullOrWhiteSpace(branding?.LogoUrl))
                    {
                        <img src="@branding.LogoUrl" alt="@branding.DisplayName" class="kb-brand-logo" />
                    }
                    else
                    {
                        <span class="kb-brand-mark" aria-hidden="true">L</span>
                    }
                    <strong>LoyaltyCloud</strong>
                </div>
                <button type="button" class="kb-icon-button kb-sidebar-close" aria-label="Cerrar navegación" data-admin-menu-close><NavIcon Name="close" /></button>
            </div>

            <nav class="kb-sidebar-nav" data-admin-menu-nav>
                @if (isPoints)
                {
                <span class="kb-sidebar-section">Principal</span>
                <NavLink href="/dashboard" Match="NavLinkMatch.All"><NavIcon Name="dashboard" /><span>Dashboard</span></NavLink>
                <NavLink href="/scan"><NavIcon Name="plus" /><span>Escanear QR</span></NavLink>
                <NavLink href="/redeem"><NavIcon Name="scan" /><span>Canjear puntos</span></NavLink>
                }

                <span class="kb-sidebar-section">Programa</span>
                @if (isPoints)
                {
                <NavLink href="/redemptions"><NavIcon Name="history" /><span>Canjes</span></NavLink>
                <NavLink href="/rewards"><NavIcon Name="gift" /><span>Recompensas</span></NavLink>
                <NavLink href="/campaigns"><NavIcon Name="spark" /><span>Campañas</span></NavLink>
                }
                else
                {
                    <AuthorizeView Policy="@LoyaltyCloud.Admin.Auth.TenantAuthorizationPolicies.CashierOperations">
                        <NavLink href="/cashier"><NavIcon Name="scan" /><span>Operaciones</span></NavLink>
                    </AuthorizeView>
                }
                <NavLink href="/marketing-notifications"><NavIcon Name="message" /><span>Mensajes</span></NavLink>

                @if (giftCardsEnabled)
                {
                    <span class="kb-sidebar-section">Tarjetas de regalo</span>
                    <NavLink href="/giftcards" Match="NavLinkMatch.All"><NavIcon Name="dashboard" /><span>Resumen</span></NavLink>
                    <NavLink href="/giftcards/issue"><NavIcon Name="plus" /><span>Emitir</span></NavLink>
                    <NavLink href="/giftcards/redeem"><NavIcon Name="scan" /><span>Consultar y canjear</span></NavLink>
                    <NavLink href="/giftcards/cards" Match="NavLinkMatch.Prefix"><NavIcon Name="card" /><span>Tarjetas</span></NavLink>
                }

                <span class="kb-sidebar-section">Reportes</span>
                <NavLink href="/customers"><NavIcon Name="users" /><span>Clientes</span></NavLink>
                @if (isPoints)
                {
                    <NavLink href="/reports/activity-trends"><NavIcon Name="history" /><span>Actividad y tendencias</span></NavLink>
                }
                @if (giftCardsEnabled)
                {
                    <NavLink href="/giftcards/reports"><NavIcon Name="gift" /><span>Tarjetas de regalo</span></NavLink>
                }

                <span class="kb-sidebar-section">Configuración</span>
                @if (!isPoints)
                {
                    <NavLink href="/stamps"><NavIcon Name="levels" /><span>Sellos</span></NavLink>
                }
                @if (isPoints)
                {
                    <NavLink href="/levels"><NavIcon Name="levels" /><span>Niveles</span></NavLink>
                }
                <NavLink href="/config"><NavIcon Name="settings" /><span>Diseño y configuración</span></NavLink>
                <NavLink href="@($"/{TenantContext.TenantSlug}/billing")"><NavIcon Name="card" /><span>Suscripción y pagos</span></NavLink>
                <NavLink href="/staff"><NavIcon Name="users" /><span>Personal</span></NavLink>
                <NavLink href="/quick-help"><NavIcon Name="help" /><span>Ayuda</span></NavLink>
            </nav>
            <div class="kb-sidebar-footer">
                <div class="kb-tenant-summary">
                    <span class="kb-tenant-avatar" aria-hidden="true">@TenantInitial</span>
                    <div><strong>@TenantName</strong><span>Administrador</span></div>
                </div>
                <form method="post" action="/logout" class="kb-signout">
                    <AntiforgeryToken />
                    <button type="submit" class="kb-sidebar-logout"><NavIcon Name="logout" /><span>Cerrar sesión</span></button>
                </form>
            </div>
        </aside>

        <main class="kb-main"><div class="kb-content">
            @if (pageAllowed) { @Body }
            else
            {
                <h1>Programa no disponible</h1>
                <p>Esta página no corresponde al programa de tu negocio.</p>
                <a class="kb-btn kb-btn--primary" href="@(isPoints ? "/dashboard" : "/cashier")">Volver al programa</a>
            }
        </div></main>
    </div>
}

@code {
    private LoyaltyCloud.Application.Common.Interfaces.TenantBrandingInfo? branding;
    private bool canRender;
    private bool giftCardsEnabled;
    private bool isPoints;
    private bool pageAllowed;

    private string TenantName => branding?.DisplayName ?? "LoyaltyCloud";
    private string TenantInitial => TenantName.Trim()[..1].ToUpperInvariant();
    private string TenantStyle => branding is null ? string.Empty : $"--kb-blush:{branding.PrimaryColor};--kb-sand-100:{branding.SecondaryColor};";

    protected override void OnInitialized() => GiftCardFeatureState.Changed += OnGiftCardsChangedAsync;
    private Task OnGiftCardsChangedAsync(bool enabled) { giftCardsEnabled = enabled; return InvokeAsync(StateHasChanged); }
    public void Dispose() => GiftCardFeatureState.Changed -= OnGiftCardsChangedAsync;

    protected override async Task OnParametersSetAsync()
    {
        canRender = false;
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (principal.Identity?.IsAuthenticated != true)
        {
            pageAllowed = true;
            canRender = true;
            return;
        }
        if (await Auth.IsBillingOnlyAsync(principal))
        {
            var tenantSlug = principal.FindFirst(LoyaltyCloud.Admin.Auth.AdminClaimTypes.TenantSlug)?.Value;
            Navigation.NavigateTo($"/{tenantSlug}/billing", forceLoad: true);
            return;
        }

        await TenantInitializer.EnsureTenantContextAsync();
        var program = await Programs.GetCurrentAsync();
        isPoints = program == LoyaltyCloud.Domain.Enums.LoyaltyProgramType.Points;
        pageAllowed = AdminProgramNavigation.IsAllowed(program, Navigation.ToBaseRelativePath(Navigation.Uri));

        if (branding is null)
        {
            try { branding = await Branding.GetCurrentAsync(); }
            catch { branding = null; }
        }

        try { giftCardsEnabled = await GiftCards.IsEnabledAsync(); }
        catch { giftCardsEnabled = false; }

        canRender = true;
    }
}

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@using LoyaltyCloud.Admin.Auth
@code {
    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var authenticated = principal.Identity?.IsAuthenticated == true;
        if (authenticated)
        {
            var destination = principal.IsInRole(TenantUserRoles.Cashier) ? "/cashier" : "/dashboard";
            Nav.NavigateTo(destination);
            return;
        }
        var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        var path = new Uri(Nav.Uri).AbsolutePath;
        var loginPath = LoyaltyCloud.Admin.Auth.AdminLoginRedirects.ResolveLoginPath(path);
        Nav.NavigateTo($"{loginPath}?returnUrl={returnUrl}", forceLoad: true);
    }
}

@*
  Pill con el color correspondiente al nivel. Se queda como un solo span
  para que se pueda inline en filas de tabla / encabezados.
*@

<span class="kb-level @CssClass">@Level</span>

@code {
    /// <summary>Nombre del nivel configurado para el tenant.</summary>
    [Parameter, EditorRequired] public string Level { get; set; } = string.Empty;

    private string CssClass => Level switch
    {
        var level when string.Equals(level, LoyaltyConstants.Levels.Radiance, StringComparison.OrdinalIgnoreCase) => "kb-level--radiance",
        var level when string.Equals(level, LoyaltyConstants.Levels.Glow, StringComparison.OrdinalIgnoreCase) => "kb-level--glow",
        var level when string.Equals(level, LoyaltyConstants.Levels.Mist, StringComparison.OrdinalIgnoreCase) => "kb-level--mist",
        _ => "kb-level--neutral"
    };
}

@using LoyaltyCloud.Application.Common.Branding

<section id="demo" class="lp-section lp-container lp-demo-section" data-landing-demo>
    <div>
        <p class="lp-eyebrow">Hazlo tuyo</p><h2>Imagina tu negocio<br /><em>en Wallet.</em></h2>
        <p>Personaliza una vista previa y descubre cómo podría verse tu programa de lealtad.</p>
        <div class="lp-demo-controls">
            <label for="demo-name">Nombre de tu negocio o programa</label>
            <input id="demo-name" type="text" maxlength="40" value="CAFÉ CENTRAL" autocomplete="off" spellcheck="false" data-demo-name />
            <label for="demo-color">Color de marca</label>
            <select id="demo-color" data-demo-color>
                @foreach (var color in Colors)
                {
                    <option value="@color.Hex" data-foreground="@WalletColorContrast.ResolveTextColors(color.Hex).ForegroundHex">@color.Name</option>
                }
            </select>
            <p class="lp-small">Vista ilustrativa. No se emite una tarjeta ni se guardan tus cambios. Al recargar, la demo vuelve al inicio.</p>
            <noscript><p>Activa JavaScript para personalizar esta vista previa.</p></noscript>
        </div>
    </div>
    <div class="lp-demo-result">
        <div class="lp-phone">
            <div class="lp-phone-top" aria-hidden="true"><span>9:41</span><span>● ▰</span></div>
            <div class="lp-phone-label">Tarjeta de lealtad · Demo</div>
            <div class="lp-wallet lp-live-wallet" data-demo-card style="--demo-bg:#354B43;--demo-fg:#FFFFFF">
                <div class="lp-wallet-brand"><span class="lp-demo-mark" aria-hidden="true">c.</span><span data-demo-title>CAFÉ CENTRAL</span></div>
                <div class="lp-live-message">Cada visita cuenta.</div>
                <div class="lp-wallet-member">Alex · Cliente de ejemplo</div>
                <div class="lp-wallet-values"><div><small>PUNTOS</small><strong>1,250</strong></div><div><small>NIVEL</small><strong>Gold</strong></div></div>
                <div class="lp-demo-code"><svg viewBox="0 0 100 30" aria-hidden="true"><path fill="currentColor" d="M0 0h3v30H0zm6 0h1v30H6zm4 0h5v30h-5zm8 0h2v30h-2zm5 0h1v30h-1zm4 0h4v30h-4zm7 0h2v30h-2zm5 0h5v30h-5zm8 0h1v30h-1zm4 0h3v30h-3zm6 0h2v30h-2zm5 0h5v30h-5zm8 0h1v30h-1zm4 0h3v30h-3zm6 0h1v30h-1zm4 0h5v30h-5zm8 0h2v30h-2zm5 0h3v30h-3z" /></svg><span>CÓDIGO DEMO · SIN VALIDEZ</span></div>
            </div>
            <p class="lp-phone-note">Presentación ilustrativa, no un pase real.</p>
        </div>
        <p>¿Te gusta cómo se ve?</p><a class="lp-button lp-button-dark" href="#comenzar">Crear mi programa ↗</a>
    </div>
</section>
@code {
    private static readonly (string Name, string Hex)[] Colors = [
        ("Bosque", "#354B43"), ("Tinta", "#1C1B18"), ("Azul profundo", "#193B62"),
        ("Vino", "#722F46"), ("Terracota", "#9C5848"), ("Arena", "#EDEAE2"), ("Blanco", "#FFFFFF")
    ];
}

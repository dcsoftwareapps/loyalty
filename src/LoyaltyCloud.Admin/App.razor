@*
  Componente raíz: emite el HTML del documento. Se renderiza una sola vez por
  request (Static SSR); a partir de ahí Routes.razor monta la app interactiva.

  La importación de fuentes Cormorant Garamond + DM Sans está aquí — son
  parte del sistema de diseño y nunca deben cambiar por página.
*@
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F5F0" />
    <base href="/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap" />

    <link rel="stylesheet" href="css/site.css" />

    <title>LoyaltyCloud Admin</title>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <div id="components-reconnect-modal" class="components-reconnect-hide" role="alert" aria-live="assertive">
        <div class="kb-reconnect-card">
            <strong>Se perdió la conexión.</strong>
            <span>Reconectando con LoyaltyCloud…</span>
            <button id="components-reconnect-button" type="button" class="kb-btn kb-btn--primary" onclick="Blazor.reconnect()">
                Reintentar
            </button>
        </div>
    </div>
    <script src="js/jsQR.js"></script>
    <script src="js/qr-scanner.js"></script>
    <script src="js/gift-card-wallet.js"></script>
    <script src="js/wallet-platform.js"></script>
    <script src="/_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start().catch(error => {
            console.error("LoyaltyCloud interactive startup failed.", error);
            const reconnectModal = document.getElementById("components-reconnect-modal");
            reconnectModal?.classList.remove("components-reconnect-hide");
            reconnectModal?.classList.add("components-reconnect-failed");
        });
    </script>
</body>
</html>
